<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Container="clr-namespace:CBHK.CustomControl.Container"
    xmlns:VectorButton="clr-namespace:CBHK.CustomControl.VectorButton"
    xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
    xmlns:dataUtility="clr-namespace:CBHK.Utility.Data">

    <controls:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <dataUtility:MetaTypeToComboBoxItemsConverter x:Key="MetaTypeToComboBoxItemsConverter" />
    <dataUtility:EnumMemberToTextComboBoxItemConverter x:Key="EnumMemberToTextComboBoxItemConverter" />

    <DataTemplate x:Key="AddButtonItem">
        <VectorButton:VectorFlatIconButton
            Command="{Binding AddItemCommand}"
            Icon="{DynamicResource TreeNodePlusGeometry}"
            IconBrush="{DynamicResource CommonForeground}"
            IconHeight="15"
            IconMargin="5"
            IconWidth="15"
            Style="{DynamicResource VectorFlatIconButtonStyle}" />
    </DataTemplate>

    <DataTemplate x:Key="RemoveButtonItem">
        <VectorButton:VectorFlatIconButton
            Command="{Binding RemoveItemCommand}"
            Icon="{DynamicResource TreeNodeMinusGeometry}"
            IconBrush="{DynamicResource CommonForeground}"
            IconHeight="15"
            IconMargin="5"
            IconWidth="15"
            Style="{DynamicResource VectorFlatIconButtonStyle}" />
    </DataTemplate>
</ResourceDictionary>