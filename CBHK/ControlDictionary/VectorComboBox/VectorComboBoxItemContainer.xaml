<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:VectorComboBox="clr-namespace:CBHK.CustomControl.VectorComboBox">

    <Style x:Key="VectorComboBoxItemContainerStyle" TargetType="{x:Type VectorComboBox:VectorComboBoxItemContainer}">
        <Setter Property="Margin" Value="0.5,0.25,0.5,0.25" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type VectorComboBox:VectorComboBoxItemContainer}">
                    <Border
                        Background="{Binding ItemContainerBackground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=VectorComboBox:VectorComboBoxItemContainer}}"
                        BorderBrush="Transparent"
                        BorderThickness="1">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!--  使用 Viewbox 包裹，统一控制最终的显示大小  -->
                            <Viewbox
                                x:Name="canvas"
                                Grid.Column="1"
                                Width="16"
                                Height="16"
                                Margin="0,0,8,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Visibility="Hidden">

                                <!--  原来的点阵 Grid 放进来，去掉 MinWidth、MinHeight 和 Margin  -->
                                <Grid UseLayoutRounding="False">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1" />
                                        <RowDefinition Height="1" />
                                        <RowDefinition Height="1" />
                                        <RowDefinition Height="1" />
                                        <RowDefinition Height="1" />
                                        <RowDefinition Height="1" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="1" />
                                    </Grid.ColumnDefinitions>

                                    <!--  下面 8 个 Rectangle 完全保留你的原代码  -->
                                    <Rectangle
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Width="2"
                                        Height="2"
                                        Fill="{Binding ItemSelectedMarkerBrush, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=VectorComboBox:VectorComboBoxItemContainer}}" />
                                    <Rectangle
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Width="2"
                                        Height="2"
                                        Fill="{Binding ItemSelectedMarkerBrush, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=VectorComboBox:VectorComboBoxItemContainer}}" />
                                    <Rectangle
                                        Grid.Row="5"
                                        Grid.Column="2"
                                        Width="2"
                                        Height="2"
                                        Fill="{Binding ItemSelectedMarkerBrush, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=VectorComboBox:VectorComboBoxItemContainer}}" />
                                    <Rectangle
                                        Grid.Row="4"
                                        Grid.Column="3"
                                        Width="2"
                                        Height="2"
                                        Fill="{Binding ItemSelectedMarkerBrush, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=VectorComboBox:VectorComboBoxItemContainer}}" />
                                    <Rectangle
                                        Grid.Row="3"
                                        Grid.Column="4"
                                        Width="2"
                                        Height="2"
                                        Fill="{Binding ItemSelectedMarkerBrush, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=VectorComboBox:VectorComboBoxItemContainer}}" />
                                    <Rectangle
                                        Grid.Row="2"
                                        Grid.Column="5"
                                        Width="2"
                                        Height="2"
                                        Fill="{Binding ItemSelectedMarkerBrush, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=VectorComboBox:VectorComboBoxItemContainer}}" />
                                    <Rectangle
                                        Grid.Row="1"
                                        Grid.Column="6"
                                        Width="2"
                                        Height="2"
                                        Fill="{Binding ItemSelectedMarkerBrush, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=VectorComboBox:VectorComboBoxItemContainer}}" />
                                    <Rectangle
                                        Grid.Row="0"
                                        Grid.Column="7"
                                        Width="2"
                                        Height="2"
                                        Fill="{Binding ItemSelectedMarkerBrush, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=VectorComboBox:VectorComboBoxItemContainer}}" />
                                </Grid>
                            </Viewbox>
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="canvas" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                <Setter Property="Margin" Value="0.5,0.5,0.5,0.25" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>