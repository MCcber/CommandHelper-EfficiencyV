<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Container="clr-namespace:CBHK.CustomControl.Container"
    xmlns:Input="clr-namespace:CBHK.CustomControl.Input"
    xmlns:VectorButton="clr-namespace:CBHK.CustomControl.VectorButton"
    xmlns:VectorComboBox="clr-namespace:CBHK.CustomControl.VectorComboBox"
    xmlns:cbhkData="clr-namespace:CBHK.Utility.Data"
    xmlns:data="clr-namespace:CBHK.Utility.Data.Mcdoc"
    xmlns:visualUtility="clr-namespace:CBHK.Utility.Visual.TreeView">

    <!--
        外观走项目控件库（Vector 控件 + CommonForeground/CommonBackground），
        不照搬 misode 的配色；功能（编辑器种类 / 按钮语义 / 层级）与之对齐。
    -->

    <!--
        树视图的本地滚动样式：行列表改用项目自绘的 VectorScrollViewer（与下拉 / 时间轴同一套，
        悬停才显出细滚动条）。只换 Template —— 页面上的 ItemContainerStyle / ItemTemplateSelector /
        ItemsSource / Background 一律不动；像素滚动 + Recycling 与原来一样显式写在模板里，
        行视图靠 FindScroll 拿的就是这个 ScrollViewer（VectorScrollViewer 继承自 ScrollViewer）。
    -->
    <Style TargetType="{x:Type data:McdocTreeRowView}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type data:McdocTreeRowView}">
                    <Container:VectorScrollViewer
                        x:Name="PART_ScrollViewer"
                        CanContentScroll="True"
                        Focusable="False"
                        HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                        Style="{DynamicResource VectorScrollViewerStyle}"
                        VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <ItemsPresenter />
                    </Container:VectorScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  行容器：去掉系统蓝框，选中/悬停用主题底色  -->
    <Style x:Key="McdocRowItemContainerStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border
                        x:Name="root"
                        Background="{TemplateBinding Background}"
                        BorderThickness="0"
                        CornerRadius="5">
                        <Grid>
                            <!--
                                祖先竖线：McdocRow.Depth 决定要画几条，每条 34px 一层（与行首按钮列同宽）。
                                用节距 34px 的斜接画刷一次铺出来，宽度绑 AncestorLineWidth，深度 0 时宽度为 0 自然不画。
                            -->
                            <Rectangle
                                Width="{Binding AncestorLineWidth}"
                                HorizontalAlignment="Left"
                                IsHitTestVisible="False"
                                Opacity="0.5">
                                <Rectangle.Fill>
                                    <DrawingBrush
                                        Stretch="None"
                                        TileMode="Tile"
                                        Viewport="0,0,34,34"
                                        ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <!--
                                                伪 3D 凹槽：1px 暗边 + 1px 反光。整套皮肤都是"描边 + 亮带/暗带"的立体语言，
                                                只画一根 1px 灰线在那排按钮旁边就显得很"2D"。
                                            -->
                                            <DrawingGroup>
                                                <GeometryDrawing Brush="{DynamicResource CommonForeground}" Geometry="M16.5,0 L17.5,0 L17.5,34 L16.5,34 Z" />
                                                <DrawingGroup Opacity="0.35">
                                                    <GeometryDrawing Brush="{DynamicResource CommonForeground}" Geometry="M17.5,0 L18.5,0 L18.5,34 L17.5,34 Z" />
                                                </DrawingGroup>
                                            </DrawingGroup>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <!--
                                子级连线：父行只画"行中线 → 行底"这半截（下半个 Grid 行），
                                子行自己的竖线从它上沿开始画，两截在行边界接上，
                                于是这条线看上去是从父行中线长出来的（不再凭空从行边界开始）。
                            -->
                            <Grid IsHitTestVisible="False" Visibility="{Binding ChildGuideVisibility}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel
                                    Grid.Row="1"
                                    Margin="{Binding ChildGuideMargin}"
                                    HorizontalAlignment="Left"
                                    Orientation="Horizontal">
                                    <Rectangle Width="1" Fill="{DynamicResource CommonForeground}" />
                                    <Rectangle
                                        Width="1"
                                        Fill="{DynamicResource CommonForeground}"
                                        Opacity="0.35" />
                                </StackPanel>
                            </Grid>
                            <ContentPresenter />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="root" Property="Background" Value="{DynamicResource CommonBackground}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="root" Property="Background" Value="{DynamicResource CommonBackground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        行内控件统一"透明背景"：主题底色只留在文字/描边上，不再给每一格铺一块白底或橙底。
        VectorTextBox 的底色由 ThemeBackground 在 Loaded/鼠标离开时覆写，所以 Background 与
        ThemeBackground 两个都要设，缺一个就会被控件自己刷回去。
    -->
    <Style x:Key="MdocBareButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        行内文本框直接用项目皮肤（VectorTextBoxStyle）：ThemeBackground=CommonBackground、
        Foreground/CaretBrush=CommonForeground、模板里的上边线 + 水印全部生效。
        以前这里把底色/描边压成 Transparent/CommonForeground，而 VectorTextBox 遇到透明主题会跳过
        UpdateBorderColorByBackgroundColor，于是永远停在"白底 + 深色 1px 边"的扁平样子。
    -->
    <Style
        x:Key="MdocTransparentTextBoxStyle"
        BasedOn="{StaticResource VectorTextBoxStyle}"
        TargetType="{x:Type Input:VectorTextBox}">
        <!--
            VectorTextBox.UpdateBorderColorByBackgroundColor 在 ThemeBackground 透明时会直接 return，
            BorderBrush 保持 null —— 行内框就只剩一块底色、四周没有边。
            下面模板用 1px Border 画完整的四边，并把描边显式钉成主题前景色。
        -->
        <Setter Property="BorderBrush" Value="{DynamicResource CommonForeground}" />
        <!--  顶部那条定位线的颜色（控件自身在透明主题下不会给它赋值，这里给个兜底）  -->
        <Setter Property="LocateLineBrush" Value="{DynamicResource CommonForeground}" />
        <!--  行内框的字号比正文小一档，这里补回来  -->
        <Setter Property="FontSize" Value="16" />
        <!--  文字竖直居中（TextBoxView 撑着内容宿主，靠 VerticalContentAlignment 居中）+ 一律靠左  -->
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="TextAlignment" Value="Left" />
        <!--
            左侧内边距不写 Padding：TextBoxBase 会把 TextBox.Padding 推给内容宿主（ScrollViewer.Padding），
            模板里若再拿 Margin 绑一次 Padding 就成了两倍（真机量到字形离左边框 7px = 1 边框 + 2 边距 + 2 边距 + 2 光标内缩）。
            Padding 归零后字形距边框内沿正好 2px（剩 TextBoxView 自带的 2px 光标内缩）。
        -->
        <Setter Property="Padding" Value="0" />
        <!--
            模板与控件字典里那份保持一致：可编辑宿主必须是 Container:VectorScrollViewer 且
            IsAllowDragToScroll="False"（外层行列表的拖拽滚动不许把鼠标抢走，见 VectorScrollViewer.IsInteractiveSource）。
            顶部 5px 定位线仍是基岩版启动器皮肤，但改画在宿主**之上**：
            内容宿主跨两行，文字才会在整块内区里竖直居中（只占第二行时字贴着上沿）。
        -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Input:VectorTextBox}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="5" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Container:VectorScrollViewer
                                x:Name="PART_ContentHost"
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                VerticalAlignment="Stretch"
                                Panel.ZIndex="1"
                                Focusable="False"
                                HorizontalScrollBarVisibility="Hidden"
                                IsAllowDragToScroll="False"
                                Style="{DynamicResource VectorScrollViewerStyle}"
                                VerticalScrollBarVisibility="Hidden" />
                            <!--  定位线必须压在宿主上面（宿主底色不透明），且不参与命中测试  -->
                            <Rectangle
                                Grid.Row="0"
                                Panel.ZIndex="2"
                                Fill="{TemplateBinding LocateLineBrush}"
                                IsHitTestVisible="False"
                                Opacity="0.6" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="MdocTransparentComboBoxStyle"
        BasedOn="{StaticResource VectorTextComboBoxStyle}"
        TargetType="{x:Type VectorComboBox:VectorTextComboBox}">
        <!--
            行内下拉必须是 34：行高 MinHeight=38，皮肤自己还要 2.5+2.5 的上下边带 + 1px 边框。
            给 40 就比行还高，被行容器（ListBoxItem 模板的圆角 Border）连边框一起裁掉，
            现象就是"顶部和底部没了"（跟顶栏那个 45 高的版本下拉没得比）。
        -->
        <Setter Property="Height" Value="34" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource CommonForeground}" />
    </Style>

    <Style
        x:Key="MdocTransparentNumberStyle"
        BasedOn="{StaticResource VectorNumbericUpDownStyle}"
        TargetType="{x:Type Input:VectorNumbericUpDown}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource CommonForeground}" />
    </Style>

    <!--
        展开/折叠：与行内 ⊕ / 🗑 同一套 VectorFlatIconButton（34×34，Icon 15 + Margin 5），
        图标只换形状不旋转：折叠 ▸ / 展开 ▾。
        仍然保留独立 Style 键 —— McdocTreeRowView.IsExpanderButton 按这个 Style 实例认"展开按钮"，
        认不出来时 Ctrl+点击整棵子树展开/折叠会静默失效。
    -->
    <Style
        x:Key="McdocRowExpanderStyle"
        BasedOn="{StaticResource VectorFlatIconButtonStyle}"
        TargetType="{x:Type VectorButton:VectorFlatIconButton}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="展开 / 折叠" />
        <Setter Property="Icon" Value="{DynamicResource MdocChevronGeometry}" />
        <Setter Property="IconBrush" Value="{DynamicResource CommonForeground}" />
        <Setter Property="IconWidth" Value="15" />
        <Setter Property="IconHeight" Value="15" />
        <Setter Property="IconMargin" Value="5" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                <Setter Property="Icon" Value="{DynamicResource MdocChevronDownGeometry}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="McdocRowLabelStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource CommonForeground}" />
        <Setter Property="Margin" Value="6,0" />
        <!--  满不透明：旁边按钮的图标/文字都是实心的，标签半透就会被读成"平的"  -->
        <Setter Property="Opacity" Value="1" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--  动作按钮：平时隐藏，悬停该行才显现；Visibility 仍由业务决定，这里只动 Opacity 以免布局跳动  -->
    <Style x:Key="McdocActionGroupStyle" TargetType="StackPanel">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="4,0,0,0" />
    </Style>

    <!--  图标的公共定值：项目控件库的 Icon 只吃 Geometry  -->
    <Style x:Key="McdocRowIconStyle" TargetType="Path">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Fill" Value="{DynamicResource CommonForeground}" />
        <Setter Property="Stretch" Value="Uniform" />
    </Style>

    <!--  行内小图标：一律内联 Vector path（Icon.xaml 多为 DrawingImage/png，不能给 Path.Data）  -->
    <!--  展开箭头用本文件私有 key，不能复用 RightArrow：Generator 的 Window.Resources 常把它重定义成 ImageBrush  -->
    <Geometry x:Key="MdocChevronGeometry">M 0,0 L 6,5 L 0,10 Z</Geometry>
    <Geometry x:Key="MdocChevronDownGeometry">M 0,0 L 10,0 L 5,6 Z</Geometry>
    <Geometry x:Key="MdocSyncGeometry">F1 M 11,2 A 9,9 0 1 0 20,11 L 17,11 A 6,6 0 1 1 11,5 L 11,8 L 16,4 L 11,0 Z</Geometry>
    <Geometry x:Key="MdocArrowUpGeometry">M 0,10 L 6,0 L 12,10 Z</Geometry>
    <Geometry x:Key="MdocArrowDownGeometry">M 0,0 L 6,10 L 12,0 Z</Geometry>
    <Geometry x:Key="MdocDuplicateGeometry">F1 M 0,0 L 8,0 L 8,8 L 0,8 Z M 4,4 L 12,4 L 12,12 L 4,12 Z</Geometry>
    <Geometry x:Key="MdocRenameGeometry">M 1,11 L 1,13 L 3,13 L 12,4 L 10,2 Z M 11,1 L 13,3 L 12,4 L 10,2 Z</Geometry>
    <Geometry x:Key="MdocTrashGeometry">F1 M 2,2 L 12,2 L 12,4 L 2,4 Z M 3,5 L 11,5 L 10,13 L 4,13 Z</Geometry>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <data:MdocItemIconConverter x:Key="MdocItemIconConverter" />
    <cbhkData:HexToBrushConverter x:Key="HexToBrushConverter" />
    <cbhkData:HexStringToColorConverter x:Key="HexStringToColorConverter" />
    <cbhkData:CategoryToBrushConverter x:Key="CategoryToBrushConverter" />

    <!--  ===== 值编辑器（DataContext = McdocTreeNode）=====  -->
    <DataTemplate x:Key="McdocEmptyEditor">
        <Border Width="0" Height="0" />
    </DataTemplate>

    <!--
        misode 的 <input list=datalist>：白名单外 #[id] 既能手输任意 id，也能从候选里选。
        控件库里 VectorTextComboBox 的模板没有 PART_EditableTextBox（IsEditable 的触发器被注释掉了），
        所以这里用「文本框 + 窄候选下拉」的组合，不擅自改控件字典。
    -->
    <DataTemplate x:Key="McdocTextEditor">
        <Grid Width="236" Height="34">
            <Input:VectorTextBox
                x:Name="plainEditor"
                Height="34"
                VerticalAlignment="Center"
                FontSize="16"
                Style="{StaticResource MdocTransparentTextBoxStyle}"
                Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
            <!--  有候选就只给一件控件：再加一个文本框是多余的（需要手输就改右侧 JSON）  -->
            <Grid x:Name="customSelectEditor" Visibility="Collapsed">
                <VectorComboBox:VectorTextComboBox
                    Width="236"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    DisplayMemberPath="Text"
                    Foreground="{DynamicResource CommonForeground}"
                    ItemsSource="{Binding EnumOptionList, Converter={StaticResource EnumMemberToTextComboBoxItemConverter}}"
                    SelectedItem="{Binding SelectedEnumOption, Converter={StaticResource EnumMemberToTextComboBoxItemConverter}}"
                    Style="{StaticResource MdocTransparentComboBoxStyle}"
                    ToolTip="从候选里选一个" />
            </Grid>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding AllowCustomValue}" Value="True">
                <Setter TargetName="plainEditor" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="customSelectEditor" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--  misode NumericHead：数字输入 + （#[random] 时）重掷按钮  -->
    <DataTemplate x:Key="McdocNumberEditor">
        <StackPanel Orientation="Horizontal">
            <!--  数字框沿用本地主题资产：底色/前景/光标色都来自 VectorTextBoxStyle（换主题自动跟随）  -->
            <!--
                别给 VerticalAlignment="Center"：VectorTextBoxStyle 的模板根 Border 绑了 VerticalAlignment，
                控件一居中，Border 就按内容高度（定位线 5 + 一行字）收缩，画出来只有 22 高，
                比右边那两颗 34 高的 加/减 按钮矮两圈。拉伸（默认）才画满 34。
            -->
            <!--
                数字框直接走行内文本框那套皮肤（MdocTransparentTextBoxStyle）：字号 16、竖直居中、左侧内边距 2
                都是它带来的；用裸的 VectorTextBoxStyle 时字贴在定位线下面（5px 那条占位行没人补），看着就是"小字靠上"。
            -->
            <Input:VectorTextBox
                Width="140"
                Height="34"
                Style="{StaticResource MdocTransparentTextBoxStyle}"
                Text="{Binding NumberText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <!--
                减 / 加并排一行：左减（箭头向左）、右加（箭头向右）。
                单个按钮占满 28×34，与左侧输入框同高（数字框画满 34，见上面那条注释）。
            -->
            <Grid
                Width="56"
                Height="34"
                Margin="4,0,0,0"
                VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <VectorButton:VectorIconRepeatButton
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{Binding DecreaseCommand}"
                    Delay="300"
                    Focusable="False"
                    IconAngle="90"
                    IconBrush="{DynamicResource CommonForeground}"
                    Interval="50"
                    IsTabStop="False"
                    OriginBottomHeight="3"
                    Style="{DynamicResource VectorIconRepeatButtonStyle}"
                    ToolTip="减一（按住连续减）" />
                <VectorButton:VectorIconRepeatButton
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{Binding IncreaseCommand}"
                    Delay="300"
                    Focusable="False"
                    IconAngle="-90"
                    IconBrush="{DynamicResource CommonForeground}"
                    Interval="50"
                    IsTabStop="False"
                    OriginBottomHeight="3"
                    Style="{DynamicResource VectorIconRepeatButtonStyle}"
                    ToolTip="加一（按住连续加）" />
            </Grid>
            <VectorButton:VectorFlatIconButton
                Width="34"
                Command="{Binding RegenerateSeedCommand}"
                Icon="{DynamicResource MdocSyncGeometry}"
                IconBrush="{DynamicResource CommonForeground}"
                IconHeight="15"
                IconMargin="5"
                IconWidth="15"
                Style="{DynamicResource VectorFlatIconButtonStyle}"
                ToolTip="重新生成随机值"
                Visibility="{Binding RandomButtonVisibility}" />
        </StackPanel>
    </DataTemplate>

    <!--  misode BooleanHead：False / True 两个按钮，选中态高亮  -->
    <DataTemplate x:Key="McdocBoolEditor">
        <StackPanel Orientation="Horizontal">
            <VectorButton:VectorToggleTextButton
                Height="34"
                FontSize="14"
                IsChecked="{Binding IsFalse, Mode=TwoWay}"
                OriginBottomHeight="4"
                Style="{DynamicResource VectorToggleTextButtonStyle}"
                Text="False" />
            <VectorButton:VectorToggleTextButton
                Height="34"
                FontSize="14"
                IsChecked="{Binding IsTrue, Mode=TwoWay}"
                OriginBottomHeight="4"
                Style="{DynamicResource VectorToggleTextButtonStyle}"
                Text="True" />
        </StackPanel>
    </DataTemplate>

    <!--  枚举 / #[id] 注册表引用：项目库下拉  -->
    <DataTemplate x:Key="McdocEnumEditor">
        <VectorComboBox:VectorTextComboBox
            Width="236"
            VerticalAlignment="Center"
            Background="Transparent"
            DisplayMemberPath="Text"
            FontSize="14"
            Foreground="{DynamicResource CommonForeground}"
            ItemsSource="{Binding EnumOptionList, Converter={StaticResource EnumMemberToTextComboBoxItemConverter}}"
            SelectedItem="{Binding SelectedEnumOption, Converter={StaticResource EnumMemberToTextComboBoxItemConverter}}"
            Style="{StaticResource MdocTransparentComboBoxStyle}" />
    </DataTemplate>

    <DataTemplate x:Key="McdocInlineTupleEditor">
        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <!--
                    元组里的内联数字与数字行同一套：主题底色输入框 + 右侧并排 减/加（左减右加）
                    （原来用 VectorNumbericUpDown，它自带的步进不通知绑定、打字也不落盘）
                -->
                <DataTemplate>
                    <StackPanel Margin="2,0" Orientation="Horizontal">
                        <Input:VectorTextBox
                            Width="58"
                            Height="34"
                            Style="{StaticResource MdocTransparentTextBoxStyle}"
                            Text="{Binding NumberText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid
                            Width="40"
                            Height="34"
                            Margin="2,0,0,0"
                            VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="20" />
                            </Grid.ColumnDefinitions>
                            <VectorButton:VectorIconRepeatButton
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Command="{Binding DecreaseCommand}"
                                Delay="300"
                                Focusable="False"
                                IconAngle="90"
                                IconBrush="{DynamicResource CommonForeground}"
                                Interval="50"
                                IsTabStop="False"
                                OriginBottomHeight="2"
                                Style="{DynamicResource VectorIconRepeatButtonStyle}"
                                ToolTip="减一（按住连续减）" />
                            <VectorButton:VectorIconRepeatButton
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Command="{Binding IncreaseCommand}"
                                Delay="300"
                                Focusable="False"
                                IconAngle="-90"
                                IconBrush="{DynamicResource CommonForeground}"
                                Interval="50"
                                IsTabStop="False"
                                OriginBottomHeight="2"
                                Style="{DynamicResource VectorIconRepeatButtonStyle}"
                                ToolTip="加一（按住连续加）" />
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

    <!--
        misode AnyHead：先选 JSON 类型，再给**该类型自己的**编辑器。
        以前不管选的是哪一项，右边永远是"原始 JSON 文本框"：选 string 要用户自己写引号、
        选 struct/list 明明已经按类型摊开了子行、行上还挂着一个空 JSON 框（用户原话：
        "添加出来的子节点求解得不太对，因为交互控件不跟着类型走"）。
        现在按选中的类型换控件：string→文本、double→数字、boolean→False/True、
        list/struct→不留值编辑器（值在子行里编），只有"没有值/认不出形状"才退回原始 JSON。
    -->
    <DataTemplate x:Key="McdocRawEditor">
        <StackPanel Orientation="Horizontal">
            <VectorComboBox:VectorTextComboBox
                Width="130"
                VerticalAlignment="Center"
                Background="Transparent"
                DisplayMemberPath="Text"
                Foreground="{DynamicResource CommonForeground}"
                ItemsSource="{Binding AnyTypeOptions, Converter={StaticResource EnumMemberToTextComboBoxItemConverter}}"
                SelectedItem="{Binding SelectedAnyType, Converter={StaticResource EnumMemberToTextComboBoxItemConverter}}"
                Style="{StaticResource MdocTransparentComboBoxStyle}" />
            <Grid VerticalAlignment="Center">
                <Input:VectorTextBox
                    x:Name="anyStringEditor"
                    Width="236"
                    Height="34"
                    VerticalAlignment="Center"
                    Style="{StaticResource MdocTransparentTextBoxStyle}"
                    Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="Collapsed" />
                <Input:VectorTextBox
                    x:Name="anyNumberEditor"
                    Width="140"
                    Height="34"
                    Style="{StaticResource MdocTransparentTextBoxStyle}"
                    Text="{Binding NumberText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="Collapsed" />
                <StackPanel
                    x:Name="anyBoolEditor"
                    Orientation="Horizontal"
                    Visibility="Collapsed">
                    <VectorButton:VectorToggleTextButton
                        Height="34"
                        FontSize="14"
                        IsChecked="{Binding IsFalse, Mode=TwoWay}"
                        OriginBottomHeight="4"
                        Style="{DynamicResource VectorToggleTextButtonStyle}"
                        Text="False" />
                    <VectorButton:VectorToggleTextButton
                        Height="34"
                        FontSize="14"
                        IsChecked="{Binding IsTrue, Mode=TwoWay}"
                        OriginBottomHeight="4"
                        Style="{DynamicResource VectorToggleTextButtonStyle}"
                        Text="True" />
                </StackPanel>
                <Input:VectorTextBox
                    x:Name="anyRawEditor"
                    Width="236"
                    Height="34"
                    VerticalAlignment="Center"
                    Style="{StaticResource MdocTransparentTextBoxStyle}"
                    Text="{Binding RawJson, UpdateSourceTrigger=LostFocus}" />
            </Grid>
        </StackPanel>
        <DataTemplate.Triggers>
            <!--  判据一律用稳定键 AnyTypeKey（显示名是大写 Boolean/String…，不许拿来比较）  -->
            <DataTrigger Binding="{Binding AnyTypeKey}" Value="string">
                <Setter TargetName="anyStringEditor" Property="Visibility" Value="Visible" />
                <Setter TargetName="anyRawEditor" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding AnyTypeKey}" Value="double">
                <Setter TargetName="anyNumberEditor" Property="Visibility" Value="Visible" />
                <Setter TargetName="anyRawEditor" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding AnyTypeKey}" Value="boolean">
                <Setter TargetName="anyBoolEditor" Property="Visibility" Value="Visible" />
                <Setter TargetName="anyRawEditor" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <!--  list / struct：值就在子行里，行上不留第二个编辑入口，也不放说明文字  -->
            <DataTrigger Binding="{Binding AnyTypeKey}" Value="list">
                <Setter TargetName="anyRawEditor" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding AnyTypeKey}" Value="struct">
                <Setter TargetName="anyRawEditor" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding AnyTypeKey}" Value="{x:Null}">
                <Setter TargetName="anyRawEditor" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="McdocColorEditor">
        <StackPanel Orientation="Horizontal">
            <Border
                Width="24"
                Height="24"
                Margin="2,0,4,0"
                VerticalAlignment="Center"
                Background="{Binding Value, Converter={StaticResource HexToBrushConverter}}"
                BorderBrush="{DynamicResource CommonForeground}"
                BorderThickness="1"
                CornerRadius="3" />
            <Input:VectorTextBox
                Width="160"
                Height="34"
                Style="{StaticResource MdocTransparentTextBoxStyle}"
                Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="McdocEditorPreview">
        <TextBlock
            Margin="5,0"
            VerticalAlignment="Center"
            FontSize="13"
            Foreground="{DynamicResource CommonForeground}"
            Text="{Binding PreviewText}"
            TextTrimming="CharacterEllipsis" />
    </DataTemplate>

    <DataTemplate x:Key="McdocColorPickerEditor">
        <Input:VectorColorPicker
            Width="220"
            Height="34"
            VerticalAlignment="Center"
            SelectedColor="{Binding Value, Mode=TwoWay, Converter={StaticResource HexStringToColorConverter}}"
            Style="{DynamicResource VectorColorPickerStyle}" />
    </DataTemplate>

    <!--
        带图标的下拉项：图标直接画在框**里面**（闭合态显示选中项、展开态显示每一行），
        所以行上不再单独摆一个 Image + 瓷砖占位方块。
        Image 的源由 MdocItemIconConverter 按 id 去 ImageSet 找 png，没有贴图就留空（该项只显示文字）。
    -->
    <DataTemplate x:Key="MdocIconComboItemTemplate">
        <!--  图标列定宽：没有贴图的 id 也留出这一格，文字才不会跟着左右跳  -->
        <!--
            行高写在模板上（皮肤那版是把 Grid.Height 绑到 combo 的 ActualHeight，我们这版没绑）：
            MinHeight=30 让展开后每行都有地方站；闭合框把 Padding 的上下改成 0（见 McdocIconSelectEditor），
            34 高的框里正好放下 30 高的一行、且上下留白相等。
        -->
        <Grid
            MinHeight="30"
            VerticalAlignment="Center"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image
                Grid.Column="0"
                Width="22"
                Height="22"
                VerticalAlignment="Center"
                RenderOptions.BitmapScalingMode="HighQuality"
                Source="{Binding ItemID, Converter={StaticResource MdocItemIconConverter}}" />
            <TextBlock
                Grid.Column="1"
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                FontSize="15"
                Foreground="{DynamicResource CommonForeground}"
                Text="{Binding Text}"
                TextTrimming="CharacterEllipsis" />
        </Grid>
    </DataTemplate>



    <!--
        misode 的 ItemIdPreview：方块 / 物品 id 用带图标的下拉，图标就在框里，不再另占一格。
        候选项必须过转换器：VectorIconTextComboBox 的模板绑的是 item.Text / item.Image，
        直接喂 EnumMember 时每一行都是空的（"物品枚举节点里成员看不见文本"）；
        DisplayMemberPath 也没用 —— ItemTemplate 会压掉它。
    -->
    <DataTemplate x:Key="McdocIconSelectEditor">
        <VectorComboBox:VectorIconTextComboBox
            Width="260"
            Height="34"
            Padding="6,0,5,0"
            VerticalAlignment="Center"
            VerticalContentAlignment="Center"
            Foreground="{DynamicResource CommonForeground}"
            ItemTemplate="{StaticResource MdocIconComboItemTemplate}"
            ItemsSource="{Binding EnumOptionList, Converter={StaticResource EnumMemberToTextComboBoxItemConverter}}"
            SelectedItem="{Binding SelectedEnumOption, Converter={StaticResource EnumMemberToTextComboBoxItemConverter}}"
            Style="{DynamicResource VectorIconTextComboBoxStyle}" />
    </DataTemplate>

    <data:McdocValueEditorTemplateSelector
        x:Key="McdocValueEditorTemplateSelector"
        BoolEditor="{StaticResource McdocBoolEditor}"
        ColorEditor="{StaticResource McdocColorEditor}"
        ColorPickerEditor="{StaticResource McdocColorPickerEditor}"
        EmptyEditor="{StaticResource McdocEmptyEditor}"
        EnumEditor="{StaticResource McdocEnumEditor}"
        IconSelectEditor="{StaticResource McdocIconSelectEditor}"
        InlineTupleEditor="{StaticResource McdocInlineTupleEditor}"
        NumberEditor="{StaticResource McdocNumberEditor}"
        Preview="{StaticResource McdocEditorPreview}"
        RawEditor="{StaticResource McdocRawEditor}"
        TextEditor="{StaticResource McdocTextEditor}" />

    <!--  行首标记：删除入口 / 颜色（misode 的 Errors + 色块）。感叹号不在这里，它在行尾（模板最右）  -->
    <DataTemplate x:Key="MdocRowMarkerTemplate">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <!--
                版本更迭后遗留的键（schema 里没有这个键）：行首这颗与行尾「删除这个键」**完全同款**（Icon 15 + IconMargin 5）。
                按钮本体 = 边框 1+1 + 描边列 3+3 + (15+5+5) = 33，所以行首列宽必须 ≥33（这里给 34），列窄了就会左右被裁。
            -->
            <VectorButton:VectorFlatIconButton
                Width="34"
                Command="{Binding UnknownDeleteCommand}"
                Icon="{DynamicResource MdocTrashGeometry}"
                IconBrush="{DynamicResource CommonForeground}"
                IconHeight="15"
                IconMargin="5"
                IconWidth="15"
                Style="{DynamicResource VectorFlatIconButtonStyle}"
                ToolTip="当前版本不存在该节点（版本更迭后遗留的键），点击删除"
                Visibility="{Binding UnknownDeleteVisibility}" />
            <!--
                map 条目行的删除入口（行首）：条目就是"这一行"，与可选字段的「清空」不是一回事。
                值被（未设置）清掉后键已经不在文档里、这一行还在 —— 那时点它就是摘掉这一行。
            -->
            <VectorButton:VectorFlatIconButton
                Width="34"
                Command="{Binding RemoveEntryCommand}"
                Icon="{DynamicResource TreeNodeMinusGeometry}"
                IconBrush="{DynamicResource CommonForeground}"
                IconHeight="15"
                IconMargin="5"
                IconWidth="15"
                Style="{DynamicResource VectorFlatIconButtonStyle}"
                ToolTip="删除这个条目"
                Visibility="{Binding RemoveEntryVisibility}" />
            <Border
                Width="10"
                Height="10"
                Margin="0,1"
                Background="{Binding ColorSwatchBrush}"
                BorderBrush="{DynamicResource CommonForeground}"
                BorderThickness="1"
                CornerRadius="2"
                ToolTip="{Binding Node.Value}"
                Visibility="{Binding ColorBadgeVisibility}" />
        </StackPanel>
    </DataTemplate>

    <!--
        行内展开/折叠按钮：三套行模板共用一份；可见性只有一条判据（真的有子级 / 必选容器）。
        可选且缺省的字段只有一行 ⊕，不挂这个按钮。
    -->
    <DataTemplate x:Key="MdocRowExpander">
        <VectorButton:VectorFlatIconButton
            Command="{Binding ToggleExpandedCommand}"
            Style="{StaticResource McdocRowExpanderStyle}"
            Visibility="{Binding ExpanderVisibility}" />
    </DataTemplate>

    <!--  misode Key：标签可点开 doc 面板；有文档时带下划线  -->
    <DataTemplate x:Key="MdocKeyTemplate">
        <Grid>
            <!--  只有真的有文档时才是"可点的标签"：没有文档不给手型、不弹空面板  -->
            <Button
                HorizontalContentAlignment="Stretch"
                Command="{Binding ToggleDocCommand}"
                Focusable="False"
                IsHitTestVisible="{Binding HasDocumentation}">
                <Button.Style>
                    <Style BasedOn="{StaticResource MdocBareButtonStyle}" TargetType="Button">
                        <Setter Property="Cursor" Value="Arrow" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDocumentation}" Value="True">
                                <Setter Property="Cursor" Value="Hand" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <!--
                    名称底板：主题底色、直角，横向撑满"键"这一格（列是 Auto/MinWidth=72，撑满的是**已经占住**的格宽，
                    Border 的 DesiredWidth 仍然只有文字宽，所以既不会把右边的编辑器挤走，也不会动左边的箭头列）。
                    没有编辑器的行还会跨过那根空列（KeyPlateColumnSpan），右沿直接贴到动作按钮上。
                -->
                <Border
                    Height="34"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CommonBackground}"
                    SnapsToDevicePixels="True"
                    Visibility="{Binding KeyPlateVisibility}">
                    <TextBlock Text="{Binding DisplayLabel}">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource McdocRowLabelStyle}" TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDocumentation}" Value="True">
                                        <Setter Property="TextDecorations" Value="Underline" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Button>
            <Popup
                AllowsTransparency="True"
                IsOpen="{Binding IsDocOpen, Mode=TwoWay}"
                Placement="Bottom"
                StaysOpen="False">
                <Border
                    MaxWidth="420"
                    Padding="8,6"
                    Background="{DynamicResource CommonBackground}"
                    BorderBrush="{DynamicResource CommonForeground}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <TextBlock
                        data:McdocMarkdown.Source="{Binding Documentation}"
                        FontSize="12"
                        Foreground="{DynamicResource CommonForeground}"
                        TextWrapping="Wrap" />
                </Border>
            </Popup>
        </Grid>
    </DataTemplate>

    <!--
        列表项动作组：PlainRow / UnionRow 共用。
        列表元素类型可能是结构（PlainRow）也可能是 union（UnionRow，例如 advancement display.title.extra 的 Text 项），
        只给 PlainRow 会让 union 列表成员没有 ▲▼/复制/⊖（截图里的 Entry 就是这种）。
    -->
    <DataTemplate x:Key="MdocListItemActions">
        <!--
            间距挂在按钮上，不挂在容器上：这一组在非列表行里是**空**的，
            容器带 margin 时那 4px 会凭空留在底板和动作按钮之间（真机实测 10px 空隙就是这么来的）。
        -->
        <StackPanel Margin="0" Style="{StaticResource McdocActionGroupStyle}">
            <VectorButton:VectorFlatIconButton
                Width="34"
                Height="34"
                VerticalAlignment="Center"
                Command="{Binding MoveUpCommand}"
                Focusable="False"
                Icon="{DynamicResource MdocArrowUpGeometry}"
                IconBrush="{DynamicResource CommonForeground}"
                IconHeight="15"
                IconMargin="5"
                IconWidth="15"
                Style="{DynamicResource VectorFlatIconButtonStyle}"
                ToolTip="上移"
                Visibility="{Binding MoveVisibility}" />
            <VectorButton:VectorFlatIconButton
                Width="34"
                Height="34"
                VerticalAlignment="Center"
                Command="{Binding MoveDownCommand}"
                Focusable="False"
                Icon="{DynamicResource MdocArrowDownGeometry}"
                IconBrush="{DynamicResource CommonForeground}"
                IconHeight="15"
                IconMargin="5"
                IconWidth="15"
                Style="{DynamicResource VectorFlatIconButtonStyle}"
                ToolTip="下移"
                Visibility="{Binding MoveVisibility}" />
            <VectorButton:VectorFlatIconButton
                Width="34"
                Height="34"
                VerticalAlignment="Center"
                Command="{Binding DuplicateCommand}"
                Focusable="False"
                Icon="{DynamicResource MdocDuplicateGeometry}"
                IconBrush="{DynamicResource CommonForeground}"
                IconHeight="15"
                IconMargin="5"
                IconWidth="15"
                Style="{DynamicResource VectorFlatIconButtonStyle}"
                ToolTip="复制这一项"
                Visibility="{Binding DuplicateVisibility}" />
            <VectorButton:VectorFlatIconButton
                Width="34"
                Height="34"
                VerticalAlignment="Center"
                Command="{Binding RemoveSelfCommand}"
                Focusable="False"
                Icon="{DynamicResource TreeNodeMinusGeometry}"
                IconBrush="{DynamicResource CommonForeground}"
                IconHeight="15"
                IconMargin="5"
                IconWidth="15"
                Style="{DynamicResource VectorFlatIconButtonStyle}"
                ToolTip="删除这一项"
                Visibility="{Binding RemoveSelfVisibility}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="McdocAddTailRow">
        <Grid
            MinHeight="38"
            Margin="{Binding Indent}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <VectorButton:VectorFlatIconButton
                Grid.Column="2"
                Width="34"
                Height="34"
                VerticalAlignment="Center"
                Command="{Binding AddTailCommand}"
                Icon="{DynamicResource TreeNodePlusGeometry}"
                IconBrush="{DynamicResource CommonForeground}"
                IconHeight="15"
                IconMargin="5"
                IconWidth="15"
                Style="{DynamicResource VectorFlatIconButtonStyle}"
                ToolTip="追加一条"
                Visibility="{Binding AddTailVisibility}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="McdocPlainRow">
        <Grid
            MinHeight="38"
            Margin="{Binding Indent}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="Auto" MinWidth="72" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentControl
                Grid.Column="0"
                Content="{Binding}"
                ContentTemplate="{StaticResource MdocRowMarkerTemplate}" />
            <ContentControl
                Grid.Column="1"
                Content="{Binding}"
                ContentTemplate="{StaticResource MdocRowExpander}" />
            <ContentControl
                Grid.Column="2"
                Grid.ColumnSpan="{Binding KeyPlateColumnSpan}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Content="{Binding}"
                ContentTemplate="{StaticResource MdocKeyTemplate}" />
            <Border
                Grid.Column="3"
                VerticalAlignment="Center"
                BorderBrush="{Binding ErrorBorderBrush}"
                BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <ContentControl
                        VerticalAlignment="Center"
                        Content="{Binding EditorContent}"
                        ContentTemplateSelector="{StaticResource McdocValueEditorTemplateSelector}" />
                    <Grid Visibility="{Binding DiagnosticBadgeVisibility}">
                        <Button
                            Command="{Binding ToggleDiagnosticsCommand}"
                            Cursor="Hand"
                            Focusable="False"
                            Style="{StaticResource MdocBareButtonStyle}">
                            <TextBlock
                                Margin="4,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{Binding ErrorBrush}"
                                Text="!"
                                ToolTip="{Binding DiagnosticSummary}" />
                        </Button>
                        <Popup
                            AllowsTransparency="True"
                            IsOpen="{Binding IsDiagnosticsOpen, Mode=TwoWay}"
                            Placement="Bottom"
                            StaysOpen="False">
                            <Border
                                MaxWidth="420"
                                Padding="8,6"
                                Background="{DynamicResource CommonBackground}"
                                BorderBrush="{Binding ErrorBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <ItemsControl ItemsSource="{Binding Diagnostics}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource CommonForeground}"
                                                Text="{Binding}"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>
            </Border>
            <StackPanel
                Grid.Column="4"
                Margin="{Binding ActionGroupMargin}"
                Style="{StaticResource McdocActionGroupStyle}">
                <VectorButton:VectorFlatIconButton
                    Width="34"
                    Margin="0,0,4,0"
                    Command="{Binding AddTopCommand}"
                    Icon="{DynamicResource TreeNodePlusGeometry}"
                    IconBrush="{DynamicResource CommonForeground}"
                    IconHeight="15"
                    IconMargin="5"
                    IconWidth="15"
                    Style="{DynamicResource VectorFlatIconButtonStyle}"
                    ToolTip="在顶部新增"
                    Visibility="{Binding ListAddTopVisibility}" />
                <!--  misode 的列表行只有一个 add（add_top）；追加到尾部走 AddBottomCommand，不占行的按钮位  -->
                <VectorButton:VectorFlatIconButton
                    Width="34"
                    Margin="0,0,4,0"
                    Command="{Binding SetDefaultCommand}"
                    Icon="{DynamicResource TreeNodePlusGeometry}"
                    IconBrush="{DynamicResource CommonForeground}"
                    IconHeight="15"
                    IconMargin="5"
                    IconWidth="15"
                    Style="{DynamicResource VectorFlatIconButtonStyle}"
                    ToolTip="设默认值"
                    Visibility="{Binding SetDefaultVisibility}" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MdocListItemActions}" />
                <!--  可选且编辑器自己清不空（容器 / 取色器 / Raw）：行尾只留这一个删除入口  -->
                <VectorButton:VectorFlatIconButton
                    Width="34"
                    Command="{Binding ClearCommand}"
                    Icon="{DynamicResource MdocTrashGeometry}"
                    IconBrush="{DynamicResource CommonForeground}"
                    IconHeight="15"
                    IconMargin="5"
                    IconWidth="15"
                    Style="{DynamicResource VectorFlatIconButtonStyle}"
                    ToolTip="删除这个键（从文档里去掉）"
                    Visibility="{Binding ClearVisibility}" />
                <!--  当前版本不存在该节点：感叹号放在行尾（模板最右侧），行首只留删除入口  -->
                <TextBlock
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="#FFC107"
                    Text="!"
                    ToolTip="当前版本不存在该节点（版本更迭后遗留的键）：内容不解析、不渲染，可点行首按钮删除"
                    Visibility="{Binding UnknownBadgeVisibility}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="McdocUnionRow">
        <Grid
            MinHeight="38"
            Margin="{Binding Indent}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="Auto" MinWidth="72" />
                <ColumnDefinition
                    Width="Auto"
                    MinWidth="120"
                    MaxWidth="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentControl
                Grid.Column="0"
                Content="{Binding}"
                ContentTemplate="{StaticResource MdocRowMarkerTemplate}" />
            <ContentControl
                Grid.Column="1"
                Content="{Binding}"
                ContentTemplate="{StaticResource MdocRowExpander}" />
            <ContentControl
                Grid.Column="2"
                VerticalAlignment="Center"
                Content="{Binding}"
                ContentTemplate="{StaticResource MdocKeyTemplate}" />
            <VectorComboBox:VectorTextComboBox
                Grid.Column="3"
                VerticalAlignment="Center"
                Background="Transparent"
                DisplayMemberPath="Text"
                Foreground="{DynamicResource CommonForeground}"
                ItemsSource="{Binding UnionOptions, Converter={StaticResource EnumMemberToTextComboBoxItemConverter}}"
                SelectedItem="{Binding SelectedUnionOption, Converter={StaticResource EnumMemberToTextComboBoxItemConverter}}"
                Style="{StaticResource MdocTransparentComboBoxStyle}" />
            <ContentControl
                Grid.Column="4"
                VerticalAlignment="Center"
                Content="{Binding EditorContent}"
                ContentTemplateSelector="{StaticResource McdocValueEditorTemplateSelector}" />
            <StackPanel Grid.Column="5" Style="{StaticResource McdocActionGroupStyle}">
                <VectorButton:VectorFlatIconButton
                    Width="34"
                    Margin="0,0,4,0"
                    Command="{Binding Node.AddItemCommand}"
                    Icon="{DynamicResource TreeNodePlusGeometry}"
                    IconBrush="{DynamicResource CommonForeground}"
                    IconHeight="15"
                    IconMargin="5"
                    IconWidth="15"
                    Style="{DynamicResource VectorFlatIconButtonStyle}"
                    ToolTip="新增"
                    Visibility="{Binding ListButtonsVisibility}" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MdocListItemActions}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="McdocKeyedRow">
        <Grid
            MinHeight="38"
            Margin="{Binding Indent}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="Auto" MinWidth="72" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentControl
                Grid.Column="0"
                Content="{Binding}"
                ContentTemplate="{StaticResource MdocRowMarkerTemplate}" />
            <ContentControl
                Grid.Column="1"
                Content="{Binding}"
                ContentTemplate="{StaticResource MdocRowExpander}" />
            <Grid Grid.Column="2" Grid.ColumnSpan="{Binding KeyPlateColumnSpan}">
                <!--  条目行的键以标签显示（键编辑框收起时必须有人顶上去）  -->
                <ContentControl
                    Content="{Binding}"
                    ContentTemplate="{StaticResource MdocKeyTemplate}"
                    Visibility="{Binding KeyLabelVisibility}" />
                <data:McdocKeyBox
                    Height="34"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource MdocTransparentTextBoxStyle}"
                    Text="{Binding Node.EditingKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="{Binding KeyTextVisibility}" />
                <VectorComboBox:VectorTextComboBox
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    DisplayMemberPath="Text"
                    Foreground="{DynamicResource CommonForeground}"
                    ItemsSource="{Binding KeyOptions, Converter={StaticResource EnumMemberToTextComboBoxItemConverter}}"
                    SelectedItem="{Binding SelectedKey, Converter={StaticResource EnumMemberToTextComboBoxItemConverter}}"
                    Style="{StaticResource MdocTransparentComboBoxStyle}"
                    Visibility="{Binding KeyComboVisibility}" />
            </Grid>
            <Border
                Grid.Column="3"
                VerticalAlignment="Center"
                BorderBrush="{Binding ErrorBorderBrush}"
                BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <ContentControl
                        VerticalAlignment="Center"
                        Content="{Binding EditorContent}"
                        ContentTemplateSelector="{StaticResource McdocValueEditorTemplateSelector}" />
                    <Grid Visibility="{Binding DiagnosticBadgeVisibility}">
                        <Button
                            Command="{Binding ToggleDiagnosticsCommand}"
                            Cursor="Hand"
                            Focusable="False"
                            Style="{StaticResource MdocBareButtonStyle}">
                            <TextBlock
                                Margin="4,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{Binding ErrorBrush}"
                                Text="!"
                                ToolTip="{Binding DiagnosticSummary}" />
                        </Button>
                        <Popup
                            AllowsTransparency="True"
                            IsOpen="{Binding IsDiagnosticsOpen, Mode=TwoWay}"
                            Placement="Bottom"
                            StaysOpen="False">
                            <Border
                                MaxWidth="420"
                                Padding="8,6"
                                Background="{DynamicResource CommonBackground}"
                                BorderBrush="{Binding ErrorBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <ItemsControl ItemsSource="{Binding Diagnostics}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource CommonForeground}"
                                                Text="{Binding}"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>
            </Border>
            <StackPanel
                Grid.Column="4"
                Margin="{Binding ActionGroupMargin}"
                Style="{StaticResource McdocActionGroupStyle}">
                <!--  any 行的 list 分支：⊕ 加一项（CanAddTop 只在"值是数组"时为真，别的条目行不显示）  -->
                <VectorButton:VectorFlatIconButton
                    Width="34"
                    Command="{Binding AddTopCommand}"
                    Icon="{DynamicResource TreeNodePlusGeometry}"
                    IconBrush="{DynamicResource CommonForeground}"
                    IconHeight="15"
                    IconMargin="5"
                    IconWidth="15"
                    Style="{DynamicResource VectorFlatIconButtonStyle}"
                    ToolTip="添加一项"
                    Visibility="{Binding ListAddTopVisibility}" />
                <VectorButton:VectorFlatIconButton
                    Width="34"
                    Command="{Binding Node.AddEntryCommand}"
                    CommandParameter="{Binding}"
                    Icon="{DynamicResource TreeNodePlusGeometry}"
                    IconBrush="{DynamicResource CommonForeground}"
                    IconHeight="15"
                    IconMargin="5"
                    IconWidth="15"
                    Style="{DynamicResource VectorFlatIconButtonStyle}"
                    ToolTip="加入"
                    Visibility="{Binding AddEntryVisibility}" />
                <VectorButton:VectorFlatIconButton
                    Width="34"
                    Command="{Binding RenameKeyCommand}"
                    Icon="{DynamicResource MdocRenameGeometry}"
                    IconBrush="{DynamicResource CommonForeground}"
                    IconHeight="14"
                    IconMargin="5"
                    IconWidth="14"
                    Style="{DynamicResource VectorFlatIconButtonStyle}"
                    ToolTip="重命名这个键"
                    Visibility="{Binding RenameVisibility}" />
                <!--  条目删除已挪到行首（MdocRowMarkerTemplate）：同一行只留一个删除入口  -->
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!--
        动态键的「新键」占位行：键控件（自由文本用输入框、#[id] 键用候选下拉）+ 右侧 ⊕。
        以前输入框是 Stretch + Auto 列，宽度由同格的提示语撑开、字压在框里 ——
        整行看起来就是一句说明文字（用户的原话是"这个节点没有 Key"）。
        现在：输入框自己固定 236 宽（与其它行的值编辑器同宽），提示语叠在**框内**（ClipToBounds 夹住），
        且只在"自由文本输入框 + 键名还空着"时显示；候选下拉形态不叠字（下拉皮肤自带亮带会横穿文字），
        靠下拉自己的 ToolTip 说明。
    -->
    <DataTemplate x:Key="McdocPlaceholderRow">
        <Grid
            MinHeight="38"
            Margin="{Binding Indent}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentControl
                Grid.Column="0"
                Content="{Binding}"
                ContentTemplate="{StaticResource MdocRowMarkerTemplate}" />
            <!--
                占位行的显示名（如 "Custom Data"）：取自父级给的 Desc，**不进 JSON**。
                真没有名字时（候选键 map）Auto 列宽为 0，布局跟以前一样。
            -->
            <ContentControl
                Grid.Column="2"
                VerticalAlignment="Center"
                Content="{Binding}"
                ContentTemplate="{StaticResource MdocKeyTemplate}" />
            <!--
                Grid 夹住键格的 236 宽：提示语（水印）叠在输入框**里面**，靠 ClipToBounds + 内侧边距
                保证字不会越出键入范围；键名一敲就 Collapsed。
            -->
            <Grid
                Grid.Column="3"
                Width="236"
                ClipToBounds="True">
                <data:McdocKeyBox
                    Width="236"
                    Height="34"
                    Style="{StaticResource MdocTransparentTextBoxStyle}"
                    Text="{Binding Node.EditingKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="新键：在这里敲名字，再点右侧 +"
                    Visibility="{Binding KeyTextVisibility}" />
                <VectorComboBox:VectorTextComboBox
                    Width="236"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    DisplayMemberPath="Text"
                    Foreground="{DynamicResource CommonForeground}"
                    ItemsSource="{Binding KeyOptions, Converter={StaticResource EnumMemberToTextComboBoxItemConverter}}"
                    SelectedItem="{Binding SelectedKey, Converter={StaticResource EnumMemberToTextComboBoxItemConverter}}"
                    Style="{StaticResource MdocTransparentComboBoxStyle}"
                    ToolTip="新键：从候选里选一个键名，再点右侧 +"
                    Visibility="{Binding KeyComboVisibility}" />
                <TextBlock
                    Margin="10,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{DynamicResource CommonForeground}"
                    IsHitTestVisible="False"
                    Opacity="0.55"
                    Text="新键：起个名字，再点 +"
                    TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <!--  只有"自由文本输入框 + 键名还空着"才叠水印：候选下拉的皮肤自带亮带，字压上去会被横穿  -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Node.EditingKey}" Value="" />
                                        <Condition Binding="{Binding KeyTextVisibility}" Value="Visible" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <VectorButton:VectorFlatIconButton
                Grid.Column="4"
                Width="34"
                Height="34"
                VerticalAlignment="Center"
                Command="{Binding Node.AddEntryCommand}"
                CommandParameter="{Binding}"
                Icon="{DynamicResource TreeNodePlusGeometry}"
                IconBrush="{DynamicResource CommonForeground}"
                IconHeight="15"
                IconMargin="5"
                IconWidth="15"
                Style="{DynamicResource VectorFlatIconButtonStyle}"
                ToolTip="新增键" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="McdocMoreRow">
        <Grid
            MinHeight="38"
            Margin="{Binding Indent}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentControl
                Grid.Column="0"
                Content="{Binding}"
                ContentTemplate="{StaticResource MdocRowMarkerTemplate}" />
            <TextBlock
                Grid.Column="2"
                Margin="6,0"
                VerticalAlignment="Center"
                FontSize="13"
                Foreground="{DynamicResource CommonForeground}"
                Opacity="0.78"
                Text="{Binding MoreLabel}" />
            <StackPanel Grid.Column="3" Style="{StaticResource McdocActionGroupStyle}">
                <VectorButton:VectorFlatIconButton
                    Width="34"
                    Command="{Binding ShowMoreCommand}"
                    Icon="{DynamicResource TreeNodePlusGeometry}"
                    IconBrush="{DynamicResource CommonForeground}"
                    IconHeight="15"
                    IconMargin="5"
                    IconWidth="15"
                    Style="{DynamicResource VectorFlatIconButtonStyle}"
                    ToolTip="再多显示 50 条" />
                <VectorButton:VectorFlatIconButton
                    Width="34"
                    Command="{Binding ShowAllCommandRow}"
                    Icon="{DynamicResource Checkmark}"
                    IconBrush="{DynamicResource CommonForeground}"
                    IconHeight="15"
                    IconMargin="5"
                    IconWidth="15"
                    Style="{DynamicResource VectorFlatIconButtonStyle}"
                    ToolTip="全部显示" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!--  保留区容器行（"当前版本不存在（N）"）：只有展开箭头与标题，没有编辑器、没有增删按钮。  -->
    <!--  里面的键各自仍是普通未知键行（可单独删除），整体清理走公共模板区的「清理」按钮。  -->
    <DataTemplate x:Key="McdocPreservedRow">
        <Grid
            MinHeight="38"
            Margin="{Binding Indent}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentControl
                Grid.Column="0"
                Content="{Binding}"
                ContentTemplate="{StaticResource MdocRowMarkerTemplate}" />
            <ContentControl
                Grid.Column="1"
                Content="{Binding}"
                ContentTemplate="{StaticResource MdocRowExpander}" />
            <TextBlock
                Grid.Column="2"
                Margin="6,0"
                VerticalAlignment="Center"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{DynamicResource CommonForeground}"
                Opacity="0.9"
                Text="{Binding DisplayLabel}"
                ToolTip="{Binding Tooltip}" />
        </Grid>
    </DataTemplate>

    <data:McdocRowTemplateSelector
        x:Key="McdocRowTemplateSelector"
        AddTailRow="{StaticResource McdocAddTailRow}"
        KeyedRow="{StaticResource McdocKeyedRow}"
        MoreRow="{StaticResource McdocMoreRow}"
        PlaceholderRow="{StaticResource McdocPlaceholderRow}"
        PlainRow="{StaticResource McdocPlainRow}"
        PreservedRow="{StaticResource McdocPreservedRow}"
        UnionRow="{StaticResource McdocUnionRow}" />
</ResourceDictionary>

