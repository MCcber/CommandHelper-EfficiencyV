<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Container="clr-namespace:CBHK.CustomControl.Container"
    xmlns:Input="clr-namespace:CBHK.CustomControl.Input"
    xmlns:VectorButton="clr-namespace:CBHK.CustomControl.VectorButton"
    xmlns:VectorComboBox="clr-namespace:CBHK.CustomControl.VectorComboBox"
    xmlns:treeViewVisualUtility="clr-namespace:CBHK.Utility.Visual.TreeView"
    xmlns:visualUtility="clr-namespace:CBHK.Utility.Visual">
    <treeViewVisualUtility:TreeViewControlSizeConverter x:Key="TreeViewControlSizeConverter" />

    <HierarchicalDataTemplate x:Key="TreeViewStructItem" ItemsSource="{Binding Children}">
        <TextBlock
            Margin="0,2"
            VerticalAlignment="Center"
            Background="Transparent"
            FontSize="15"
            Foreground="{DynamicResource CommonForeground}"
            IsHitTestVisible="False"
            Text="{Binding FieldName}"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
    </HierarchicalDataTemplate>

    <!--  , Converter={StaticResource MetaTypeToComboBoxItemsConverter}  -->
    <HierarchicalDataTemplate x:Key="TreeViewUnionItem" ItemsSource="{Binding SelectedUnionChildren}">
        <Border
            Margin="0,2"
            VerticalAlignment="Center"
            Background="{DynamicResource CommonBackground}"
            BorderBrush="Transparent"
            BorderThickness="0"
            CornerRadius="5"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <DockPanel>
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        FontSize="15"
                        Foreground="{DynamicResource CommonForeground}"
                        Text="{Binding FieldName}" />
                    <VectorComboBox:VectorTextComboBox
                        Title="{Binding FieldName}"
                        VerticalAlignment="Center"
                        ArrowMargin="0 0 8 0"
                        ItemsSource="{Binding UnionTypeNameList, Converter={StaticResource EnumMemberToTextComboBoxItemConverter}}"
                        SelectedItem="{Binding SelectedUnionTypeName, Converter={StaticResource EnumMemberToTextComboBoxItemConverter}}"
                        Style="{DynamicResource VectorTextComboBoxStyle}" />
                </DockPanel>
            </StackPanel>
        </Border>
    </HierarchicalDataTemplate>

    <HierarchicalDataTemplate x:Key="TreeViewArrayItem" ItemsSource="{Binding Items}">
        <Border
            Margin="0,2"
            VerticalAlignment="Center"
            Background="Transparent"
            BorderBrush="{DynamicResource CommonBackground}"
            BorderThickness="1"
            CornerRadius="5"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock
                Margin="5,0,0,0"
                Background="Transparent"
                FontSize="15"
                Foreground="{DynamicResource CommonForeground}"
                IsHitTestVisible="False"
                Text="{Binding FieldName}"
                TextAlignment="Left" />
        </Border>
    </HierarchicalDataTemplate>

    <HierarchicalDataTemplate x:Key="TreeViewListItem" ItemsSource="{Binding Items}">
        <Border
            VerticalAlignment="Center"
            Background="{DynamicResource CommonBackground}"
            BorderBrush="Transparent"
            BorderThickness="0"
            CornerRadius="5"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="5,0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    FontSize="15"
                    Foreground="{DynamicResource CommonForeground}"
                    IsHitTestVisible="False"
                    Text="{Binding FieldName}" />
                <VectorButton:VectorFlatIconButton
                    Grid.Column="1"
                    Command="{Binding AddItemCommand}"
                    CommandParameter="{Binding}"
                    Icon="{DynamicResource TreeNodePlusGeometry}"
                    IconBrush="{DynamicResource CommonForeground}"
                    IconHeight="15"
                    IconMargin="5"
                    IconWidth="15"
                    Style="{DynamicResource VectorFlatIconButtonStyle}" />
                <VectorButton:VectorFlatIconButton
                    Grid.Column="2"
                    Command="{Binding ClearItemCommand}"
                    CommandParameter="{Binding}"
                    Icon="{DynamicResource TreeNodeMinusGeometry}"
                    IconBrush="{DynamicResource CommonForeground}"
                    IconHeight="15"
                    IconMargin="5"
                    IconWidth="15"
                    Style="{DynamicResource VectorFlatIconButtonStyle}" />
            </Grid>
        </Border>
    </HierarchicalDataTemplate>

    <HierarchicalDataTemplate x:Key="TreeViewEntryItem" ItemsSource="{Binding Children}">
        <Grid Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <VectorButton:VectorFlatIconButton
                Grid.Column="0"
                Width="30"
                Height="30"
                Command="{Binding RemoveItemCommand}"
                Icon="{DynamicResource TreeNodeMinusGeometry}"
                IconBrush="{DynamicResource CommonForeground}"
                IconHeight="15"
                IconMargin="5"
                IconWidth="15"
                Style="{DynamicResource VectorFlatIconButtonStyle}" />
            <TextBlock
                Grid.Column="1"
                Margin="5,0"
                HorizontalAlignment="Left"
                Background="Transparent"
                FontSize="15"
                Foreground="{DynamicResource CommonForeground}"
                Text="{Binding FieldName}" />
        </Grid>
    </HierarchicalDataTemplate>

    <DataTemplate x:Key="TreeViewDefinitionItem">
        <Input:VectorTextBox
            Height="40"
            VerticalAlignment="Center"
            visualUtility:TextSizeHelper.AutoFontSize="True"
            Foreground="{DynamicResource CommonForeground}"
            Style="{DynamicResource VectorTextBoxStyle}"
            Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
            WaterMarkerBrush="{DynamicResource CommonForeground}"
            WaterMarkerMargin="2 0 0 0"
            WaterMarkerText="Please Input Key" />
    </DataTemplate>

    <HierarchicalDataTemplate x:Key="TreeViewBoolItem">
        <Grid VerticalAlignment="Center" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Column="0"
                Margin="5,0"
                VerticalAlignment="Center"
                Background="Transparent"
                FontSize="15"
                Foreground="{DynamicResource CommonForeground}"
                IsHitTestVisible="False"
                Text="{Binding FieldName}" />
            <VectorButton:VectorToggleTextButton
                Grid.Column="1"
                Height="40"
                VerticalAlignment="Center"
                IsChecked="{Binding IsTrue, Mode=TwoWay}"
                OriginBottomHeight="4"
                Style="{DynamicResource VectorToggleTextButtonStyle}"
                Text="True" />
            <VectorButton:VectorToggleTextButton
                Grid.Column="2"
                Height="40"
                VerticalAlignment="Center"
                IsChecked="{Binding IsFalse, Mode=TwoWay}"
                OriginBottomHeight="4"
                Style="{DynamicResource VectorToggleTextButtonStyle}"
                Text="False" />
            <Viewbox
                Grid.Column="2"
                Width="35"
                Height="35"
                Margin="5,0,0,0"
                VerticalAlignment="Center"
                ToolTip="{Binding LiteralValue}"
                ToolTipService.BetweenShowDelay="1000"
                ToolTipService.InitialShowDelay="0"
                Visibility="Collapsed">
                <Path
                    Data="{Binding Icon}"
                    Fill="{Binding IconBrush}"
                    Stroke="{Binding IconBrush}"
                    StrokeThickness="1" />
            </Viewbox>
        </Grid>
    </HierarchicalDataTemplate>

    <HierarchicalDataTemplate x:Key="TreeViewNumberTemplate">
        <Grid VerticalAlignment="Center" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Margin="5,0"
                VerticalAlignment="Center"
                Background="Transparent"
                FontSize="15"
                Foreground="{DynamicResource CommonForeground}"
                IsHitTestVisible="False"
                Text="{Binding FieldName}"
                TextAlignment="Left" />
            <Input:VectorNumbericUpDown
                Grid.Column="1"
                Height="40"
                Style="{DynamicResource VectorNumbericUpDownStyle}"
                Text="{Binding Value}" />
            <Viewbox
                Grid.Column="2"
                Width="{Binding Height, RelativeSource={RelativeSource Mode=Self}}"
                Height="40"
                Margin="5,0,0,0"
                ToolTip="{Binding Key}"
                ToolTipService.BetweenShowDelay="1000"
                ToolTipService.InitialShowDelay="0">
                <Path
                    Data="{Binding Icon}"
                    Fill="{Binding IconBrush}"
                    Stroke="{Binding IconBrush}"
                    StrokeThickness="1" />
            </Viewbox>
        </Grid>
    </HierarchicalDataTemplate>

    <HierarchicalDataTemplate x:Key="TreeViewStringItem">
        <Grid
            MinWidth="200"
            VerticalAlignment="Center"
            Background="Transparent"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Margin="5,0"
                VerticalAlignment="Center"
                Background="Transparent"
                FontSize="15"
                Foreground="{DynamicResource CommonForeground}"
                Text="{Binding FieldName}" />
            <Input:VectorTextBox
                Grid.Column="1"
                Height="40"
                VerticalAlignment="Center"
                visualUtility:TextSizeHelper.AutoFontSize="True"
                Style="{DynamicResource VectorTextBoxStyle}"
                Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
            <Viewbox
                Grid.Column="2"
                Width="35"
                Height="35"
                Margin="5,0,0,0"
                VerticalAlignment="Center"
                ToolTip="{Binding LiteralValue}"
                ToolTipService.BetweenShowDelay="1000"
                ToolTipService.InitialShowDelay="0"
                Visibility="Collapsed">
                <Path
                    Data="{Binding Icon}"
                    Fill="{Binding IconBrush}"
                    Stroke="{Binding IconBrush}"
                    StrokeThickness="1" />
            </Viewbox>
        </Grid>
    </HierarchicalDataTemplate>

    <HierarchicalDataTemplate x:Key="TreeViewUUIDItem">
        <Grid
            VerticalAlignment="Center"
            Background="Transparent"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Input:VectorTextBox
                Grid.Column="0"
                Height="40"
                Padding="2,0,0,0"
                visualUtility:TextSizeHelper.AutoFontSize="True"
                Style="{DynamicResource VectorTextBoxStyle}"
                Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                WaterMarkerBrush="{DynamicResource CommonBackground}"
                WaterMarkerMargin="5 0 0 0"
                WaterMarkerText="{Binding FieldName}" />
            <VectorButton:VectorFlatImageButton
                Grid.Column="1"
                Width="40"
                Height="40"
                Command="{Binding ReFreshCommand}"
                Image="{DynamicResource IconFresh}"
                Style="{DynamicResource VectorFlatImageButtonStyle}" />
            <Viewbox
                Grid.Column="2"
                Width="20"
                Height="20"
                Margin="5,0,0,0"
                VerticalAlignment="Center"
                ToolTip="{Binding LiteralValue}"
                ToolTipService.BetweenShowDelay="1000"
                ToolTipService.InitialShowDelay="0"
                Visibility="Collapsed">
                <Path
                    Data="{Binding Icon}"
                    Fill="{Binding IconBrush}"
                    Stroke="{Binding IconBrush}"
                    StrokeThickness="1" />
            </Viewbox>
        </Grid>
    </HierarchicalDataTemplate>

    <HierarchicalDataTemplate x:Key="TreeViewColorItem">
        <Grid VerticalAlignment="Center" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Margin="5,0"
                VerticalAlignment="Center"
                FontSize="15"
                IsHitTestVisible="False"
                Text="{Binding FieldName}"
                TextAlignment="Left" />
            <Input:VectorColorPicker
                Grid.Column="1"
                Height="40"
                SelectedColor="{Binding Value}"
                Style="{DynamicResource VectorColorPickerStyle}" />
        </Grid>
    </HierarchicalDataTemplate>

    <HierarchicalDataTemplate x:Key="TreeViewEnumItem">
        <Grid Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Margin="5,0"
                VerticalAlignment="Center"
                Background="Transparent"
                FontSize="15"
                Foreground="{DynamicResource CommonForeground}"
                Text="{Binding FieldName}" />
            <VectorComboBox:VectorTextComboBox
                Title="{Binding FieldName}"
                Grid.Column="1"
                Height="40"
                MinWidth="250"
                Background="Transparent"
                DisplayMemberPath="Text"
                Foreground="{DynamicResource CommonForeground}"
                ItemsSource="{Binding EnumOptionList, Converter={StaticResource EnumMemberToTextComboBoxItemConverter}}"
                SelectedItem="{Binding SelectedEnumOption, Converter={StaticResource EnumMemberToTextComboBoxItemConverter}}"
                Style="{DynamicResource VectorTextComboBoxStyle}" />
        </Grid>
    </HierarchicalDataTemplate>

    <!--
        注意：不能在 HierarchicalDataTemplate 上设置 ItemTemplateSelector（StaticResource 跨字典不可见；
        DynamicResource 又因 HierarchicalDataTemplate 非 DependencyObject 而抛异常）。
        子节点模板选择已改由 VectorTreeViewItemContainerStyle 的 ItemTemplateSelector Setter 提供。
    -->
    <HierarchicalDataTemplate x:Key="TreeViewCompositeItem" ItemsSource="{Binding SelectedUnionChildren}">
        <Border Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Container:BindableStackPanel
                ItemTemplateSelector="{DynamicResource MCDocumentTreeViewTemplateSelector}"
                ItemsSource="{Binding Items}"
                Orientation="Horizontal" />
        </Border>
    </HierarchicalDataTemplate>
</ResourceDictionary>