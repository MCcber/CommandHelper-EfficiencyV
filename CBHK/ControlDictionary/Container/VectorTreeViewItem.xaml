<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Container="clr-namespace:CBHK.CustomControl.Container"
    xmlns:VectorButton="clr-namespace:CBHK.CustomControl.VectorButton"
    xmlns:localContext="clr-namespace:CBHK.Utility.Visual.TreeView">

    <!--  层级垂线长度转换器  -->
    <localContext:TreeViewLineConverter x:Key="LineConverter" />
    <localContext:TreeViewControlSizeConverter x:Key="TreeViewControlSizeConverter" />

    <Style x:Key="VectorTreeViewItemContainerStyle" TargetType="{x:Type Container:VectorTreeViewItem}">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="IsExpanded" Value="False" />
        <Setter Property="Padding" Value="1,0,0,0" />
        <!--
            让每个层级（含 Composite 子级）的 TreeViewItem 都用 MCDocumentTreeViewTemplateSelector 挑选子节点模板。
            必须写在这里（TreeViewItem 是 DependencyObject，允许 DynamicResource；而
            HierarchicalDataTemplate 不是 DependencyObject，不能在它的 ItemTemplateSelector 上挂 DynamicResource）。
            选择器定义在父级 Container.xaml，StaticResource 解析期不可见，故用 DynamicResource。
        -->
        <!--<Setter Property="ItemTemplateSelector" Value="{DynamicResource MCDocumentTreeViewTemplateSelector}" />-->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Container:VectorTreeViewItem}">
                    <Grid x:Name="grid" Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="5" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" MinHeight="60" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!--#region Connecting Line And Split Lines-->
                        <Rectangle
                            Grid.Row="0"
                            Grid.ColumnSpan="3"
                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=TreeView}, Converter={StaticResource TreeViewControlSizeConverter}, ConverterParameter=10}"
                            Height="1"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Fill="{TemplateBinding ConnectingLineBrush}"
                            SnapsToDevicePixels="True"
                            Stroke="{TemplateBinding ConnectingLineBrush}"
                            Visibility="{TemplateBinding HorizontalTopLineVisibility}" />
                        <Rectangle
                            Grid.Row="0"
                            Grid.ColumnSpan="3"
                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=TreeView}, Converter={StaticResource TreeViewControlSizeConverter}, ConverterParameter=10}"
                            Height="1"
                            Margin="0,0,0,0"
                            VerticalAlignment="Bottom"
                            Fill="{TemplateBinding ConnectingLineBrush}"
                            SnapsToDevicePixels="True"
                            Stroke="{TemplateBinding ConnectingLineBrush}"
                            Visibility="{TemplateBinding HorizontalBottomLineVisibility}" />
                        <Rectangle
                            Grid.RowSpan="2"
                            Grid.Column="0"
                            Width="1"
                            Margin="0,45,0,0"
                            Fill="{TemplateBinding ConnectingLineBrush}"
                            SnapsToDevicePixels="true"
                            Stroke="{TemplateBinding ConnectingLineBrush}">
                            <Rectangle.Height>
                                <MultiBinding Converter="{StaticResource LineConverter}">
                                    <MultiBinding.Bindings>
                                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType=TreeView}" />
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=TreeView}" />
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding RelativeSource="{RelativeSource Self}" />
                                        <Binding ElementName="Expander" Path="IsChecked" />
                                    </MultiBinding.Bindings>
                                </MultiBinding>
                            </Rectangle.Height>
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Children.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                        <!--#endregion-->
                        <ToggleButton
                            x:Name="Expander"
                            Margin="5,0"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            ClickMode="Press"
                            IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                            Style="{DynamicResource VectorTreeViewToggleButtonStyle}" />
                        <ContentPresenter
                            x:Name="PART_Header"
                            Grid.Row="0"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="2,0,0,0"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            ContentSource="Header" />
                        <ItemsPresenter
                            x:Name="ItemsHost"
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="2" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="false">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="false">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <!--<MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="HasHeader" Value="false" />
                                <Condition Property="Width" Value="Auto" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Header" Property="MinWidth" Value="75" />
                        </MultiTrigger>-->
                        <!--<MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="HasHeader" Value="false" />
                                <Condition Property="Height" Value="Auto" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Header" Property="MinHeight" Value="19" />
                        </MultiTrigger>-->
                        <Trigger Property="IsSelected" Value="true">
                            <Setter TargetName="grid" Property="Background" Value="#8A8A8A" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="true" />
                                <Condition Property="IsSelectionActive" Value="false" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="White" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>