    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Common="clr-namespace:CBHK.View.Common"
    xmlns:Container="clr-namespace:CBHK.CustomControl.Container"
    xmlns:Input="clr-namespace:CBHK.CustomControl.Input"
    xmlns:VectorButton="clr-namespace:CBHK.CustomControl.VectorButton"
    xmlns:VectorCheckBox="clr-namespace:CBHK.CustomControl.VectorCheckBox"
    xmlns:VectorComboBox="clr-namespace:CBHK.CustomControl.VectorComboBox"
    xmlns:avalon="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
    xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:utility="clr-namespace:CBHK.Utility.Visual"
    Title="CommandHelper-EfficiencyV v26.4Preview4"
    Width="1080"
    Height="720"
    MinWidth="1080"
    MinHeight="720"
    prism:ViewModelLocator.AutoWireViewModel="True"
    FocusVisualStyle="{x:Null}"
    Icon="/cb.ico"
    IconMargin="5"
    RenderOptions.BitmapScalingMode="NearestNeighbor"
    RenderOptions.CachingHint="Cache"
    ShowInTaskbar="{Binding ShowInTaskBar}"
    WindowStartupLocation="CenterScreen"
    WindowState="{Binding WindowState}"
    mc:Ignorable="d">

    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger EventName="Activated">
            <behaviors:InvokeCommandAction Command="{Binding MainWindowActivatedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Container:VectorWindow}}" />
        </behaviors:EventTrigger>
        <behaviors:EventTrigger EventName="Loaded">
            <behaviors:InvokeCommandAction Command="{Binding MainWindowLoadedCommand}" />
        </behaviors:EventTrigger>
        <behaviors:EventTrigger EventName="Closing">
            <behaviors:InvokeCommandAction Command="{Binding MainWindowClosingCommand}" />
        </behaviors:EventTrigger>
    </behaviors:Interaction.Triggers>

    <Grid>
        <Container:VectorTabControl
            Background="Transparent"
            BorderThickness="0"
            SelectedIndex="0"
            Style="{DynamicResource VectorTabControlStyle}"
            TabStripPlacement="Left">
            <Container:VectorIconTextTabItem
                HeaderImage="/CBHK;component/Resource/CBHK/Image/IconHome.png"
                HeaderText="生成器"
                Style="{StaticResource VectorIconTextTabItemStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" MinHeight="80">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Input:SearchBox
                            Grid.Row="0"
                            Grid.Column="0"
                            Height="40"
                            utility:TextSizeHelper.AutoFontSize="True"
                            SearchClick="{Binding SearchGeneratorCommand}"
                            SearchIcon="{DynamicResource Magnifier}"
                            SearchIconBrush="{DynamicResource CommonForeground}"
                            SearchIconMargin="2"
                            SearhIconHeight="20"
                            SearhIconWidth="20"
                            Style="{DynamicResource SearchBoxStyle}"
                            Text="{Binding SearchString}"
                            WaterMarkerMargin="5 0 0 0"
                            WaterMarkerText="搜索生成器">
                            <behaviors:Interaction.Triggers>
                                <behaviors:EventTrigger EventName="TextChanged">
                                    <behaviors:CallMethodAction MethodName="SearchBox_TextChanged" TargetObject="{Binding}" />
                                </behaviors:EventTrigger>
                            </behaviors:Interaction.Triggers>
                        </Input:SearchBox>
                        <VectorButton:VectorFlatIconTextButton
                            Grid.Row="0"
                            Grid.Column="1"
                            MinWidth="160"
                            Command="{Binding SwitchSortListCommand}"
                            Icon="{DynamicResource UpDownArrow}"
                            IconFillBrush="{DynamicResource CommonForeground}"
                            IconHeight="20"
                            IconMargin="5 0 0 0"
                            IconWidth="20"
                            Style="{DynamicResource VectorFlatIconTextButtonStyle}"
                            Text="{Binding SelectedSortTitle}" />
                        <DockPanel
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2">
                            <VectorButton:VectorFlatIconTextButton
                                Height="40"
                                HorizontalAlignment="Left"
                                Command="{Binding SwitchCategoryListCommand}"
                                Icon="{DynamicResource Category}"
                                IconFillBrush="{DynamicResource CommonForeground}"
                                IconHeight="20"
                                IconMargin="5 0 5 0"
                                IconStrokeBrush="{DynamicResource CommonForeground}"
                                IconWidth="20"
                                Style="{DynamicResource VectorFlatIconTextButtonStyle}"
                                Text="{Binding SelectedCategoryTitle}" />
                            <ItemsControl ItemsSource="{Binding CategoryButtonList}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <VectorButton:VectorToggleImageTextButton
                                            Command="{Binding DataContext.SwitchCategoryCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}"
                                            Image="{Binding Icon}"
                                            IsChecked="{Binding IsChecked}"
                                            OriginBottomHeight="4"
                                            Style="{DynamicResource VectorToggleImageTextButtonStyle}"
                                            Text="{Binding Text}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Grid>
                    <Container:VectorScrollViewer
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Auto"
                        Style="{DynamicResource VectorScrollViewerStyle}"
                        VerticalScrollBarVisibility="Auto">
                        <Grid FocusVisualStyle="{x:Null}" Visibility="Collapsed">
                            <behaviors:Interaction.Triggers>
                                <behaviors:EventTrigger EventName="Loaded">
                                    <behaviors:InvokeCommandAction Command="{Binding GeneratorTableLoadedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}}" />
                                </behaviors:EventTrigger>
                            </behaviors:Interaction.Triggers>
                        </Grid>
