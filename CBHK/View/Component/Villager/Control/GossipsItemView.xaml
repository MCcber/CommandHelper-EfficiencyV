<UserControl
    x:Class="CBHK.View.Component.Villager.Control.GossipsItemView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Input="clr-namespace:CBHK.CustomControl.Input"
    xmlns:VectorButton="clr-namespace:CBHK.CustomControl.VectorButton"
    xmlns:VectorComboBox="clr-namespace:CBHK.CustomControl.VectorComboBox"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CBHK.View.Component.Villager.Control"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Visibility="{Binding Visibility}"
    mc:Ignorable="d">
    <Grid
        Grid.Row="1"
        Grid.Column="1"
        Margin="12,0,0,5"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="{Binding Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="1" Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <VectorButton:VectorTextButton
                Grid.Column="0"
                Background="#D0D1D4"
                Command="{Binding ApplyCommand}"
                Foreground="Black"
                OriginBottomHeight="3"
                Style="{DynamicResource VectorTextButtonStyle}"
                Text="应用" />
            <VectorButton:VectorTextButton
                Grid.Column="1"
                Background="#D0D1D4"
                Command="{Binding DeleteCommand}"
                Foreground="Black"
                OriginBottomHeight="3"
                Style="{DynamicResource VectorTextButtonStyle}"
                Text="删除" />
        </Grid>
        <Input:VectorNumbericUpDown
            Grid.Row="2"
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            AllowDrop="False"
            Background="#D0D1D4"
            BorderThickness="0"
            Foreground="White"
            Style="{DynamicResource VectorNumbericUpDownStyle}"
            WaterMarkerBrush="Gray"
            WaterMarkerMargin="5 0 0 0"
            WaterMarkerText="此言论的强度。"
            Value="{Binding GossipValue, Mode=TwoWay}" />
        <Input:VectorTextBox
            Grid.Row="3"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Height="30"
            VerticalContentAlignment="Center"
            BorderThickness="1"
            Style="{DynamicResource VectorTextBoxStyle}"
            Text="{Binding TargetText}"
            WaterMarkerBrush="Gray"
            WaterMarkerMargin="5 0 0 0"
            WaterMarkerText="引发言论的玩家的UUID" />
        <VectorComboBox:VectorTextComboBox
            Title="言论的类型"
            Grid.Row="4"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Height="40"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            ArrowMargin="0 0 5 0"
            ItemsSource="{Binding GossipTypeList}"
            SelectedIndex="0"
            SelectedItem="{Binding SelectedTypeItem}"
            SelectedValuePath="{Binding SelectedTypeItemPath}"
            Style="{DynamicResource VectorTextComboBoxStyle}"
            TitleBrush="White" />
    </Grid>
</UserControl>
