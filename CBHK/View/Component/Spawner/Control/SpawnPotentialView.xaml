<UserControl
    x:Class="CBHK.View.Component.Spawner.Control.SpawnPotentialView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Container="clr-namespace:CBHK.CustomControl.Container"
    xmlns:CustomControl="clr-namespace:CBHK.CustomControl"
    xmlns:Input="clr-namespace:CBHK.CustomControl.Input"
    xmlns:VectorButton="clr-namespace:CBHK.CustomControl.VectorButton"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CBHK.View.Component.Spawner.Control"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <VectorButton:VectorFlatImageButton
            Grid.Row="0"
            Grid.Column="1"
            Width="30"
            Height="30"
            HorizontalAlignment="Right"
            Command="{Binding DeleteCommand}"
            Image="/Resource/Common/Image/Close.png"
            ImageMargin="5"
            Style="{DynamicResource VectorFlatImageButtonStyle}" />
        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{StaticResource CommonForeground}"
            Text="Weight"
            ToolTip="相对其他生成项的选中此生成项的权重。必须是正数，且至少为1。"
            ToolTipService.BetweenShowDelay="0"
            ToolTipService.InitialShowDelay="0" />
        <Input:VectorNumbericUpDown
            Grid.Row="1"
            Grid.Column="1"
            Style="{DynamicResource VectorNumbericUpDownStyle}"
            Value="{Binding Weight, Mode=TwoWay}" />
        <Container:VectorRichExpander
            Grid.Row="2"
            Grid.ColumnSpan="2"
            ArrowMargin="0 0 10 0"
            Background="#FFE5B663"
            BorderThickness="0"
            FontSize="15"
            Header="生成规则"
            Style="{DynamicResource VectorRichExpanderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource CommonForeground}"
                    Text="方块光照限制" />
                <VectorButton:VectorToggleTextButton
                    Grid.Row="0"
                    Grid.Column="1"
                    Foreground="{StaticResource CommonForeground}"
                    IsChecked="{Binding BlockLightUseSingleValue, Mode=TwoWay}"
                    OriginBottomHeight="3"
                    Style="{DynamicResource VectorToggleTextButtonStyle}"
                    Text="整数" />
                <Input:VectorNumbericUpDown
                    Grid.Row="0"
                    Grid.Column="2"
                    Grid.ColumnSpan="5"
                    MinWidth="300"
                    Style="{DynamicResource VectorNumbericUpDownStyle}"
                    Visibility="{Binding SingleValueVisibility}"
                    Value="{Binding BlockLightValue, Mode=TwoWay}" />
                <Grid
                    Grid.Row="0"
                    Grid.Column="3"
                    Grid.ColumnSpan="4"
                    Visibility="{Binding RangeVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Input:VectorNumbericUpDown
                        Grid.Column="0"
                        Style="{DynamicResource VectorNumbericUpDownStyle}"
                        WaterMarkerText="下限"
                        Value="{Binding BlockLightMin, Mode=TwoWay}" />
                    <Input:VectorNumbericUpDown
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{DynamicResource VectorNumbericUpDownStyle}"
                        WaterMarkerText="上限"
                        Value="{Binding BlockLightMax, Mode=TwoWay}" />
                </Grid>
                <VectorButton:VectorToggleTextButton
                    Grid.Row="0"
                    Grid.Column="7"
                    HorizontalAlignment="Right"
                    Foreground="White"
                    IsChecked="{Binding UseDefaultBlockLight, Mode=TwoWay}"
                    Style="{DynamicResource VectorToggleTextButtonStyle}"
                    Text="使用默认值" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource CommonForeground}"
                    Text="天空光照限制" />
                <VectorButton:VectorToggleTextButton
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="5,5,0,0"
                    Foreground="White"
                    IsChecked="{Binding SkyLightUseSingleValue, Mode=TwoWay}"
                    OriginBottomHeight="3"
                    Style="{DynamicResource VectorToggleTextButtonStyle}"
                    Text="整数" />
                <Input:VectorNumbericUpDown
                    Grid.Row="1"
                    Grid.Column="2"
                    Grid.ColumnSpan="5"
                    MinWidth="300"
                    Style="{DynamicResource VectorNumbericUpDownStyle}"
                    Visibility="{Binding SingleValueVisibility}"
                    Value="{Binding SkyLightValue, Mode=TwoWay}" />
                <Grid
                    Grid.Row="1"
                    Grid.Column="2"
                    Grid.ColumnSpan="5"
                    Visibility="{Binding RangeVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Input:VectorNumbericUpDown
                        Grid.Column="0"
                        Style="{DynamicResource VectorNumbericUpDownStyle}"
                        WaterMarkerText="下限"
                        Value="{Binding SkyLightMin, Mode=TwoWay}" />
                    <Input:VectorNumbericUpDown
                        Grid.Column="1"
                        Style="{DynamicResource VectorNumbericUpDownStyle}"
                        WaterMarkerText="上限"
                        Value="{Binding SkyLightMax, Mode=TwoWay}" />
                </Grid>
                <VectorButton:VectorToggleTextButton
                    Grid.Row="1"
                    Grid.Column="7"
                    HorizontalAlignment="Right"
                    Foreground="White"
                    IsChecked="{Binding UseDefaultSkyLight, Mode=TwoWay}"
                    Style="{DynamicResource VectorToggleTextButtonStyle}"
                    Text="使用默认值" />
            </Grid>
        </Container:VectorRichExpander>
        <TextBlock
            Grid.Row="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{StaticResource CommonForeground}"
            Text="Entity"
            ToolTip="要生成的实体。会在准备下一次生成时覆盖SpawnData的内容。"
            ToolTipService.BetweenShowDelay="0"
            ToolTipService.InitialShowDelay="0" />
        <local:ReferenceEntityView
            Grid.Row="3"
            Grid.Column="1"
            DataContext="{Binding EntitySlot}" />
    </Grid>
</UserControl>
