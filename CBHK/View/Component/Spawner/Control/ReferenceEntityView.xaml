<UserControl
    x:Class="CBHK.View.Component.Spawner.Control.ReferenceEntityView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:VectorButton="clr-namespace:CBHK.CustomControl.VectorButton"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <DockPanel>
        <Border
            Width="40"
            Height="40"
            Background="{Binding Icon}"
            BorderBrush="Orange"
            BorderThickness="1" />
        <VectorButton:VectorTextButton
            MinWidth="80"
            HorizontalAlignment="Left"
            Command="{Binding SetEmptyCommand}"
            OriginBottomHeight="3"
            Style="{DynamicResource VectorTextButtonStyle}"
            Text="设置为空" />
        <VectorButton:VectorTextButton
            MinWidth="100"
            HorizontalAlignment="Left"
            Command="{Binding ImportFromClipboardCommand}"
            OriginBottomHeight="3"
            Style="{DynamicResource VectorTextButtonStyle}"
            Text="从剪切板读取" />
        <VectorButton:VectorTextButton
            MinWidth="100"
            HorizontalAlignment="Left"
            Command="{Binding ImportFromFileCommand}"
            OriginBottomHeight="3"
            Style="{DynamicResource VectorTextButtonStyle}"
            Text="从文件读取" />
    </DockPanel>
</UserControl>
