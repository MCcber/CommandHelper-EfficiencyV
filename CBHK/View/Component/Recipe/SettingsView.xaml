<UserControl
    x:Class="CBHK.View.Component.Recipe.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Input="clr-namespace:CBHK.CustomControl.Input"
    xmlns:VectorButton="clr-namespace:CBHK.CustomControl.VectorButton"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CBHK.View.Component.Recipe"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,10,0,0">
            <VectorButton:VectorToggleIconTextButton
                Margin="10,0,0,0"
                HorizontalAlignment="Left"
                Command="{Binding ToggleShapedCommand}"
                IsChecked="{Binding ShapedChecked, Mode=OneWay}"
                Style="{DynamicResource VectorToggleIconTextButtonStyle}"
                Text="有序"
                Visibility="{Binding ShapedVisibility}" />
            <VectorButton:VectorToggleIconTextButton
                Margin="10,0,0,0"
                HorizontalAlignment="Left"
                Command="{Binding ToggleMultiSelectCommand}"
                IsChecked="{Binding MultiSelectChecked, Mode=OneWay}"
                Style="{DynamicResource VectorToggleIconTextButtonStyle}"
                Text="多选"
                ToolTipService.BetweenShowDelay="0"
                ToolTipService.InitialShowDelay="0"
                Visibility="{Binding MultiSelectVisibility}">
                <VectorButton:VectorToggleIconTextButton.ToolTip>
                    <ToolTip
                        Background="#484848"
                        Content="开启多选后，同一个槽中只需满足一个成员即可匹配"
                        Foreground="White" />
                </VectorButton:VectorToggleIconTextButton.ToolTip>
            </VectorButton:VectorToggleIconTextButton>
            <VectorButton:VectorFlatIconButton
                Width="30"
                Height="30"
                Margin="0,0,6,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Command="{Binding CloseCommand}"
                Cursor="Hand"
                Icon="{StaticResource CloseMark}"
                IconBrush="White"
                IconHeight="10"
                IconWidth="10"
                Style="{DynamicResource VectorFlatIconButtonStyle}"
                ToolTip="关闭设置"
                ToolTipService.BetweenShowDelay="0"
                ToolTipService.InitialShowDelay="0" />
        </DockPanel>
        <Input:VectorTextBox
            Grid.Row="2"
            Height="40"
            HorizontalAlignment="Stretch"
            VerticalContentAlignment="Center"
            BorderBrush="Black"
            BorderThickness="1"
            Foreground="White"
            Style="{DynamicResource VectorTextBoxStyle}"
            Text="{Binding Owner.GroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Visibility="{Binding GroupNameVisibility}"
            WaterMarkerBrush="Gray"
            WaterMarkerMargin="5 0 0 0"
            WaterMarkerText="组标识符" />
        <Input:VectorTextBox
            Grid.Row="3"
            Height="40"
            VerticalContentAlignment="Center"
            BorderBrush="Black"
            BorderThickness="1"
            Foreground="White"
            Style="{DynamicResource VectorTextBoxStyle}"
            Text="{Binding Owner.FileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            WaterMarkerBrush="Gray"
            WaterMarkerMargin="5 0 0 0"
            WaterMarkerText="文件名" />
        <Input:VectorNumbericUpDown
            Grid.Row="4"
            Height="40"
            VerticalContentAlignment="Center"
            BorderBrush="Black"
            BorderThickness="1"
            Foreground="White"
            Style="{DynamicResource VectorNumbericUpDownStyle}"
            Value="{Binding Owner.Count, Mode=TwoWay}"
            Visibility="{Binding CountVisibility}"
            WaterMarkerBrush="Gray"
            WaterMarkerMargin="5 0 0 0"
            WaterMarkerText="结果数量" />
        <Input:VectorNumbericUpDown
            Grid.Row="5"
            BorderThickness="1"
            Foreground="White"
            Style="{DynamicResource VectorNumbericUpDownStyle}"
            Value="{Binding Owner.Experience, Mode=TwoWay}"
            Visibility="{Binding ExperienceVisibility}"
            WaterMarkerBrush="Gray"
            WaterMarkerMargin="5 0 0 0"
            WaterMarkerText="经验" />
        <Input:VectorNumbericUpDown
            Grid.Row="6"
            BorderThickness="1"
            Foreground="White"
            Style="{DynamicResource VectorNumbericUpDownStyle}"
            Value="{Binding Owner.Cookingtime, Mode=TwoWay}"
            Visibility="{Binding CookingTimeVisibility}"
            WaterMarkerBrush="Gray"
            WaterMarkerMargin="5 0 0 0"
            WaterMarkerText="烧制时间" />
        <Input:VectorTextBox
            Grid.Row="7"
            Height="40"
            VerticalContentAlignment="Center"
            BorderBrush="Black"
            BorderThickness="1"
            Foreground="White"
            Style="{DynamicResource VectorTextBoxStyle}"
            Text="{Binding Owner.TrimPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Visibility="{Binding TrimPatternVisibility}"
            WaterMarkerBrush="Gray"
            WaterMarkerMargin="5 0 0 0"
            WaterMarkerText="剪纹图案(1.21.5+)" />
    </Grid>
</UserControl>
