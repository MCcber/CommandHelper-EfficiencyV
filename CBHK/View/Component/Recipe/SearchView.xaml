<UserControl
    x:Class="CBHK.View.Component.Recipe.SearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Container="clr-namespace:CBHK.CustomControl.Container"
    xmlns:Input="clr-namespace:CBHK.CustomControl.Input"
    xmlns:VectorButton="clr-namespace:CBHK.CustomControl.VectorButton"
    xmlns:VirtualizingWrapPanel="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CBHK.View.Component.Recipe"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utility="clr-namespace:CBHK.Utility.Visual"
    d:DesignHeight="450"
    d:DesignWidth="750"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Input:VectorTextBox
                Grid.Column="0"
                Height="35"
                VerticalContentAlignment="Center"
                BorderBrush="Black"
                Foreground="{StaticResource CommonForeground}"
                Style="{DynamicResource VectorTextBoxStyle}"
                Text="{Binding CurrentKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="所有该有序合成配方用到的键。"
                ToolTipService.BetweenShowDelay="0"
                ToolTipService.InitialShowDelay="0"
                Visibility="{Binding KeyVisibility}"
                WaterMarkerText="Key" />
            <Input:VectorTextBox
                Grid.Column="1"
                Height="35"
                VerticalContentAlignment="Center"
                BorderBrush="Black"
                FontSize="15"
                Foreground="{StaticResource CommonForeground}"
                Style="{DynamicResource VectorTextBoxStyle}"
                Text="{Binding CurrentTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="该材料的标签。"
                ToolTipService.BetweenShowDelay="0"
                ToolTipService.InitialShowDelay="0"
                WaterMarkerText="Tag" />
        </Grid>
        <Input:VectorTextBox
            Grid.Row="1"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Margin="0,2"
            BorderBrush="Black"
            FontSize="20"
            Foreground="White"
            Style="{DynamicResource VectorTextBoxStyle}"
            Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            WaterMarkerText="搜索" />
        <VectorButton:VectorFlatIconButton
            Grid.Row="0"
            Grid.Column="2"
            Width="30"
            Height="30"
            Margin="6,0,0,0"
            VerticalAlignment="Center"
            Command="{Binding UpdateAndCloseCommand}"
            Cursor="Hand"
            Icon="{StaticResource CloseMark}"
            IconBrush="White"
            IconHeight="10"
            IconWidth="10"
            Style="{DynamicResource VectorFlatIconButtonStyle}"
            ToolTip="关闭并更新多选数据"
            ToolTipService.BetweenShowDelay="0"
            ToolTipService.InitialShowDelay="0" />
        <Container:VectorScrollViewer
            Grid.Row="2"
            Grid.ColumnSpan="3"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            BorderBrush="Transparent"
            BorderThickness="0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <ListView
                BorderThickness="0"
                ItemsSource="{Binding ItemsView}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                SelectionMode="Single"
                utility:ItemClickCommandHelper.RightClickCommand="{Binding DeleteItemCommand}">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingWrapPanel:VirtualizingWrapPanel
                            Background="#555956"
                            ScrollViewer.CanContentScroll="True"
                            VirtualizingPanel.CacheLength="200 200"
                            VirtualizingPanel.CacheLengthUnit="Pixel"
                            VirtualizingPanel.IsVirtualizing="True" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Image
                                Width="50"
                                Height="50"
                                Panel.ZIndex="0"
                                RenderOptions.BitmapScalingMode="NearestNeighbor"
                                RenderOptions.ClearTypeHint="Enabled"
                                SnapsToDevicePixels="True"
                                Source="{StaticResource Slot}"
                                ToolTipService.BetweenShowDelay="0"
                                ToolTipService.InitialShowDelay="0"
                                UseLayoutRounding="False" />
                            <Image
                                Width="50"
                                Height="50"
                                Panel.ZIndex="1"
                                RenderOptions.BitmapScalingMode="NearestNeighbor"
                                RenderOptions.ClearTypeHint="Enabled"
                                SnapsToDevicePixels="True"
                                Source="{Binding Path=ImagePath, IsAsync=True, Mode=OneWay}"
                                ToolTipService.BetweenShowDelay="0"
                                ToolTipService.InitialShowDelay="0"
                                UseLayoutRounding="False">
                                <Image.ToolTip>
                                    <ToolTip
                                        Background="#484848"
                                        Content="{Binding IsAsync=True, Path=IDAndName, Mode=OneWay}"
                                        Foreground="White" />
                                </Image.ToolTip>
                            </Image>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Container:VectorScrollViewer>
    </Grid>
</UserControl>
