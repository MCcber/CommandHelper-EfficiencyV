<UserControl
    x:Class="CBHK.View.Component.Recipe.CampfireView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:VectorButton="clr-namespace:CBHK.CustomControl.VectorButton"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CBHK.View.Component.Recipe"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utility="clr-namespace:CBHK.Utility.Visual"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RunCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <BitmapImage x:Key="cellBackground" UriSource="/CBHK;component/Resource/Common/Image/Recipe/Cell.png" />
    </UserControl.Resources>

    <Grid Width="450" Height="320">
        <TextBlock
            Margin="0,-10,100,0"
            HorizontalAlignment="Center"
            FontSize="40"
            FontWeight="Thin"
            Foreground="Black"
            Text="篝火" />
        <Image
            Grid.Column="0"
            Width="90"
            Height="90"
            Margin="10,55,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Panel.ZIndex="0"
            AllowDrop="True"
            RenderOptions.BitmapScalingMode="HighQuality"
            SnapsToDevicePixels="True"
            Source="{StaticResource Slot}"
            UseLayoutRounding="False" />
        <Button
            Grid.Row="0"
            Grid.Column="0"
            Width="20"
            Height="20"
            Margin="75,58,10,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Panel.ZIndex="2"
            Command="{Binding MaterialSlot.OpenCommand}"
            Content="..."
            FontWeight="Bold"
            Visibility="{Binding MaterialSlot.MultiItemVisibility}" />
        <Image
            Uid="material"
            Grid.Column="0"
            Width="80"
            Height="80"
            Margin="15,60,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Panel.ZIndex="1"
            AllowDrop="True"
            RenderOptions.BitmapScalingMode="HighQuality"
            SnapsToDevicePixels="True"
            Source="{Binding MaterialSlot.Image}"
            ToolTip="{Binding MaterialSlot.ToolTipText}"
            UseLayoutRounding="False"
            utility:DropCommandHelper.DropCommand="{Binding MaterialSlot.DropCommand}" />
        <VectorButton:VectorFlatImageButton
            Width="40"
            Height="40"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Command="{Binding RunCommand}"
            Image="/Resource/Common/Image/IconArrowRight.png"
            Style="{DynamicResource VectorFlatImageButtonStyle}"
            ToolTip="F5:运行"
            ToolTipService.BetweenShowDelay="0"
            ToolTipService.InitialShowDelay="0" />
        <Image
            Width="120"
            Height="115"
            Margin="0,45,22,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Panel.ZIndex="0"
            AllowDrop="True"
            RenderOptions.BitmapScalingMode="HighQuality"
            RenderOptions.EdgeMode="Aliased"
            SnapsToDevicePixels="True"
            Source="{StaticResource cellBackground}"
            UseLayoutRounding="False" />
        <Image
            Width="120"
            Height="115"
            Margin="0,45,22,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Panel.ZIndex="1"
            AllowDrop="True"
            RenderOptions.BitmapScalingMode="HighQuality"
            RenderOptions.EdgeMode="Aliased"
            SnapsToDevicePixels="True"
            Source="{Binding ResultSlot.Image}"
            UseLayoutRounding="False"
            utility:DropCommandHelper.DropCommand="{Binding ResultSlot.DropCommand}">
            <Image.InputBindings>
                <MouseBinding Command="{Binding ResultSlot.ClearCommand}" MouseAction="RightClick" />
            </Image.InputBindings>
        </Image>
    </Grid>

</UserControl>
