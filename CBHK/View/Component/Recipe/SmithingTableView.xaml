<UserControl
    x:Class="CBHK.View.Component.Recipe.SmithingTableView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:VectorButton="clr-namespace:CBHK.CustomControl.VectorButton"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CBHK.View.Component.Recipe"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utility="clr-namespace:CBHK.Utility.Visual"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RunCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <ImageBrush x:Key="SmithingTableBackground" ImageSource="/CBHK;component/Resource/Common/Image/Recipe/SmithingTable.png" />
        <ImageBrush x:Key="LeftArrow" ImageSource="/CBHK;component/Resource/Common/Image/IconArrowLeft.png" />
        <ImageBrush x:Key="RightArrow" ImageSource="/CBHK;component/Resource/Common/Image/IconArrowRight.png" />
    </UserControl.Resources>

    <Grid
        Width="580"
        Height="320"
        Background="{StaticResource SmithingTableBackground}">
        <Border
            Margin="25,0,0,15"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            BorderThickness="1">
            <Image
                Width="80"
                Height="80"
                AllowDrop="True"
                RenderOptions.BitmapScalingMode="HighQuality"
                SnapsToDevicePixels="True"
                Source="{Binding TemplateSlot.Image}"
                ToolTip="{Binding TemplateSlot.ToolTipText}"
                Uid="template"
                UseLayoutRounding="False"
                utility:DropCommandHelper.DropCommand="{Binding TemplateSlot.DropCommand}" />
        </Border>
        <Border
            Margin="120,0,0,15"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            BorderThickness="1">
            <Image
                Width="80"
                Height="80"
                AllowDrop="True"
                RenderOptions.BitmapScalingMode="HighQuality"
                SnapsToDevicePixels="True"
                Source="{Binding BaseSlot.Image}"
                ToolTip="{Binding BaseSlot.ToolTipText}"
                Uid="base"
                UseLayoutRounding="False"
                utility:DropCommandHelper.DropCommand="{Binding BaseSlot.DropCommand}" />
        </Border>
        <Border
            Margin="0,0,76,15"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            BorderThickness="1">
            <Image
                Width="80"
                Height="80"
                AllowDrop="True"
                RenderOptions.BitmapScalingMode="HighQuality"
                SnapsToDevicePixels="True"
                Source="{Binding AdditionSlot.Image}"
                ToolTip="{Binding AdditionSlot.ToolTipText}"
                Uid="addition"
                UseLayoutRounding="False"
                utility:DropCommandHelper.DropCommand="{Binding AdditionSlot.DropCommand}" />
        </Border>
        <VectorButton:VectorFlatImageButton
            Width="40"
            Height="40"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Command="{Binding RunCommand}"
            Image="/Resource/Common/Image/IconArrowRight.png"
            Style="{DynamicResource VectorFlatImageButtonStyle}"
            ToolTip="F5:运行"
            ToolTipService.BetweenShowDelay="0"
            ToolTipService.InitialShowDelay="0" />
        <Image
            Width="85"
            Height="85"
            Margin="0,0,8,10"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            AllowDrop="True"
            RenderOptions.BitmapScalingMode="HighQuality"
            RenderOptions.EdgeMode="Aliased"
            SnapsToDevicePixels="True"
            Source="{Binding ResultSlot.Image}"
            ToolTip="{Binding ResultSlot.ToolTipText}"
            Uid="result"
            UseLayoutRounding="False"
            utility:DropCommandHelper.DropCommand="{Binding ResultSlot.DropCommand}">
            <Image.InputBindings>
                <MouseBinding Command="{Binding ResultSlot.ClearCommand}" MouseAction="RightClick" />
            </Image.InputBindings>
        </Image>
    </Grid>

</UserControl>
