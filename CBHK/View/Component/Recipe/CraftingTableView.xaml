<UserControl
    x:Class="CBHK.View.Component.Recipe.CraftingTableView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:VectorButton="clr-namespace:CBHK.CustomControl.VectorButton"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CBHK.View.Component.Recipe"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utility="clr-namespace:CBHK.Utility.Visual"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RunCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <ImageBrush x:Key="CraftingTableBackground" ImageSource="/CBHK;component/Resource/Common/Image/Recipe/CraftingTable.png" />
    </UserControl.Resources>

    <Grid
        Width="500"
        Height="260"
        Background="{StaticResource CraftingTableBackground}">
        <Grid
            Width="228"
            Margin="5,0,0,8"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid
                Grid.Row="0"
                Grid.Column="0">
                <Image
                    Width="70"
                    Height="70"
                    Panel.ZIndex="0"
                    AllowDrop="True"
                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                    SnapsToDevicePixels="True"
                    Source="{Binding Slots[0].Image}"
                    ToolTip="{Binding Slots[0].ToolTipText}"
                    ToolTipService.BetweenShowDelay="0"
                    ToolTipService.InitialShowDelay="0"
                    Uid="1"
                    UseLayoutRounding="False"
                    utility:DropCommandHelper.DropCommand="{Binding Slots[0].DropCommand}" />
                <Button
                    Width="20"
                    Height="20"
                    Margin="0,2,7,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Panel.ZIndex="1"
                    Command="{Binding Slots[0].OpenCommand}"
                    Content="..."
                    FontWeight="Bold"
                    Visibility="{Binding Slots[0].MultiItemVisibility}" />
            </Grid>
            <Grid
                Grid.Row="0"
                Grid.Column="1">
                <Image
                    Width="70"
                    Height="70"
                    Panel.ZIndex="0"
                    AllowDrop="True"
                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                    SnapsToDevicePixels="True"
                    Source="{Binding Slots[1].Image}"
                    ToolTip="{Binding Slots[1].ToolTipText}"
                    ToolTipService.BetweenShowDelay="0"
                    ToolTipService.InitialShowDelay="0"
                    Uid="2"
                    UseLayoutRounding="False"
                    utility:DropCommandHelper.DropCommand="{Binding Slots[1].DropCommand}" />
                <Button
                    Width="20"
                    Height="20"
                    Margin="0,2,7,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Panel.ZIndex="1"
                    Command="{Binding Slots[1].OpenCommand}"
                    Content="..."
                    FontWeight="Bold"
                    Visibility="{Binding Slots[1].MultiItemVisibility}" />
            </Grid>
            <Grid
                Grid.Row="0"
                Grid.Column="2">
                <Image
                    Width="70"
                    Height="70"
                    Panel.ZIndex="0"
                    AllowDrop="True"
                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                    SnapsToDevicePixels="True"
                    Source="{Binding Slots[2].Image}"
                    ToolTip="{Binding Slots[2].ToolTipText}"
                    ToolTipService.BetweenShowDelay="0"
                    ToolTipService.InitialShowDelay="0"
                    Uid="3"
                    UseLayoutRounding="False"
                    utility:DropCommandHelper.DropCommand="{Binding Slots[2].DropCommand}" />
                <Button
                    Width="20"
                    Height="20"
                    Margin="0,2,7,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Panel.ZIndex="1"
                    Command="{Binding Slots[2].OpenCommand}"
                    Content="..."
                    FontWeight="Bold"
                    Visibility="{Binding Slots[2].MultiItemVisibility}" />
            </Grid>
            <Grid
                Grid.Row="1"
                Grid.Column="0">
                <Image
                    Width="70"
                    Height="70"
                    Panel.ZIndex="0"
                    AllowDrop="True"
                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                    SnapsToDevicePixels="True"
                    Source="{Binding Slots[3].Image}"
                    ToolTip="{Binding Slots[3].ToolTipText}"
                    ToolTipService.BetweenShowDelay="0"
                    ToolTipService.InitialShowDelay="0"
                    Uid="4"
                    UseLayoutRounding="False"
                    utility:DropCommandHelper.DropCommand="{Binding Slots[3].DropCommand}" />
                <Button
                    Width="20"
                    Height="20"
                    Margin="0,2,7,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Panel.ZIndex="1"
                    Command="{Binding Slots[3].OpenCommand}"
                    Content="..."
                    FontWeight="Bold"
                    Visibility="{Binding Slots[3].MultiItemVisibility}" />
            </Grid>
            <Grid
                Grid.Row="1"
                Grid.Column="1">
                <Image
                    Width="70"
                    Height="70"
                    Panel.ZIndex="0"
                    AllowDrop="True"
                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                    SnapsToDevicePixels="True"
                    Source="{Binding Slots[4].Image}"
                    ToolTip="{Binding Slots[4].ToolTipText}"
                    ToolTipService.BetweenShowDelay="0"
                    ToolTipService.InitialShowDelay="0"
                    Uid="5"
                    UseLayoutRounding="False"
                    utility:DropCommandHelper.DropCommand="{Binding Slots[4].DropCommand}" />
                <Button
                    Width="20"
                    Height="20"
                    Margin="0,2,7,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Panel.ZIndex="1"
                    Command="{Binding Slots[4].OpenCommand}"
                    Content="..."
                    FontWeight="Bold"
                    Visibility="{Binding Slots[4].MultiItemVisibility}" />
            </Grid>
            <Grid
                Grid.Row="1"
                Grid.Column="2">
                <Image
                    Width="70"
                    Height="70"
                    Panel.ZIndex="0"
                    AllowDrop="True"
                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                    SnapsToDevicePixels="True"
                    Source="{Binding Slots[5].Image}"
                    ToolTip="{Binding Slots[5].ToolTipText}"
                    ToolTipService.BetweenShowDelay="0"
                    ToolTipService.InitialShowDelay="0"
                    Uid="6"
                    UseLayoutRounding="False"
                    utility:DropCommandHelper.DropCommand="{Binding Slots[5].DropCommand}" />
                <Button
                    Width="20"
                    Height="20"
                    Margin="0,2,7,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Panel.ZIndex="1"
                    Command="{Binding Slots[5].OpenCommand}"
                    Content="..."
                    FontWeight="Bold"
                    Visibility="{Binding Slots[5].MultiItemVisibility}" />
            </Grid>
            <Grid
                Grid.Row="2"
                Grid.Column="0">
                <Image
                    Width="70"
                    Height="70"
                    Panel.ZIndex="0"
                    AllowDrop="True"
                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                    SnapsToDevicePixels="True"
                    Source="{Binding Slots[6].Image}"
                    ToolTip="{Binding Slots[6].ToolTipText}"
                    ToolTipService.BetweenShowDelay="0"
                    ToolTipService.InitialShowDelay="0"
                    Uid="7"
                    UseLayoutRounding="False"
                    utility:DropCommandHelper.DropCommand="{Binding Slots[6].DropCommand}" />
                <Button
                    Width="20"
                    Height="20"
                    Margin="0,2,7,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Panel.ZIndex="1"
                    Command="{Binding Slots[6].OpenCommand}"
                    Content="..."
                    FontWeight="Bold"
                    Visibility="{Binding Slots[6].MultiItemVisibility}" />
            </Grid>
            <Grid
                Grid.Row="2"
                Grid.Column="1">
                <Image
                    Width="70"
                    Height="70"
                    Panel.ZIndex="0"
                    AllowDrop="True"
                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                    SnapsToDevicePixels="True"
                    Source="{Binding Slots[7].Image}"
                    ToolTip="{Binding Slots[7].ToolTipText}"
                    ToolTipService.BetweenShowDelay="0"
                    ToolTipService.InitialShowDelay="0"
                    Uid="8"
                    UseLayoutRounding="False"
                    utility:DropCommandHelper.DropCommand="{Binding Slots[7].DropCommand}" />
                <Button
                    Width="20"
                    Height="20"
                    Margin="0,2,7,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Panel.ZIndex="1"
                    Command="{Binding Slots[7].OpenCommand}"
                    Content="..."
                    FontWeight="Bold"
                    Visibility="{Binding Slots[7].MultiItemVisibility}" />
            </Grid>
            <Grid
                Grid.Row="2"
                Grid.Column="2">
                <Image
                    Width="70"
                    Height="70"
                    Panel.ZIndex="0"
                    AllowDrop="True"
                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                    SnapsToDevicePixels="True"
                    Source="{Binding Slots[8].Image}"
                    ToolTip="{Binding Slots[8].ToolTipText}"
                    ToolTipService.BetweenShowDelay="0"
                    ToolTipService.InitialShowDelay="0"
                    Uid="9"
                    UseLayoutRounding="False"
                    utility:DropCommandHelper.DropCommand="{Binding Slots[8].DropCommand}" />
                <Button
                    Width="20"
                    Height="20"
                    Margin="0,2,7,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Panel.ZIndex="1"
                    Command="{Binding Slots[8].OpenCommand}"
                    Content="..."
                    FontWeight="Bold"
                    Visibility="{Binding Slots[8].MultiItemVisibility}" />
            </Grid>
        </Grid>
        <VectorButton:VectorFlatImageButton
            Width="40"
            Height="40"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Command="{Binding RunCommand}"
            Image="/Resource/Common/Image/IconArrowRight.png"
            Style="{DynamicResource VectorFlatImageButtonStyle}"
            ToolTip="F5:运行"
            ToolTipService.BetweenShowDelay="0"
            ToolTipService.InitialShowDelay="0" />
        <Image
            Width="85"
            Height="85"
            Margin="0,40,18,5"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            AllowDrop="True"
            RenderOptions.BitmapScalingMode="NearestNeighbor"
            RenderOptions.EdgeMode="Aliased"
            SnapsToDevicePixels="True"
            Source="{Binding ResultSlot.Image}"
            ToolTip="{Binding ResultSlot.ToolTipText}"
            ToolTipService.BetweenShowDelay="0"
            ToolTipService.InitialShowDelay="0"
            Uid="result"
            UseLayoutRounding="False"
            utility:DropCommandHelper.DropCommand="{Binding ResultSlot.DropCommand}">
            <Image.InputBindings>
                <MouseBinding Command="{Binding ResultSlot.ClearCommand}" MouseAction="RightClick" />
            </Image.InputBindings>
        </Image>
    </Grid>
</UserControl>
