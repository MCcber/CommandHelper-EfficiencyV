<Container:VectorWindow
    x:Class="CBHK.View.Generator.VillagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Container="clr-namespace:CBHK.CustomControl.Container"
    xmlns:Input="clr-namespace:CBHK.CustomControl.Input"
    xmlns:UserControlContainer="clr-namespace:CBHK.View.Component.Villager.Control"
    xmlns:VectorButton="clr-namespace:CBHK.CustomControl.VectorButton"
    xmlns:VectorComboBox="clr-namespace:CBHK.CustomControl.VectorComboBox"
    xmlns:VirtualizingWrapPanel="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
    xmlns:behavior="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CBHK.View.Generator"
    xmlns:local_datacontext="clr-namespace:CBHK.View.Generator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:utility="clr-namespace:CBHK.Utility.Visual"
    Title="村民生成器"
    Width="1220"
    Height="715"
    MinWidth="1220"
    MinHeight="715"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="#2F2F2F"
    Icon="/CBHK;component/Resource/Common/Image/SpawnerIcon/IconVillager.png"
    IconMargin="5"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <CollectionViewSource x:Key="OriginalItemView" Source="{Binding OriginalItemList, IsAsync=True}" />
        <CollectionViewSource x:Key="CustomItemView" Source="{Binding CustomItemList, IsAsync=True}" />
        <ImageBrush x:Key="EditBox" ImageSource="/CBHK;component/Resource/Common/Image/TextEditBox.png" />
        <ImageBrush x:Key="ButtonNormal" ImageSource="/CBHK;component/Resource/Common/Image/ButtonNormal.png" />
        <ImageBrush x:Key="ButtonPressed" ImageSource="/CBHK;component/Resource/Common/Image/ButtonPressed.png" />
        <ImageBrush x:Key="LeftArrow" ImageSource="/CBHK;component/Resource/Common/Image/IconArrowLeft.png" />
        <ImageBrush x:Key="RightArrow" ImageSource="/CBHK;component/Resource/Common/Image/IconArrowRight.png" />
        <ImageBrush x:Key="WhiteEdit" ImageSource="/CBHK;component/Resource/Common/Image/WhiteEdit.png" />
        <ImageBrush x:Key="BlackEdit" ImageSource="/CBHK;component/Resource/Common/Image/BlackEdit.png" />
        <ImageBrush x:Key="SaveIcon" ImageSource="/CBHK;component/Resource/Common/Image/Save.png" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RunCommand}" />
        <KeyBinding
            Key="Esc"
            Command="{Binding ReturnCommand}"
            CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Container:VectorWindow}}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel
            Grid.Row="0"
            Height="40"
            Margin="5,0,0,0">
            <VectorButton:VectorFlatImageButton
                Command="{Binding ReturnCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"
                Image="/Resource/Common/Image/IconArrowLeft.png"
                ImageMargin="2"
                Style="{DynamicResource VectorFlatImageButtonStyle}"
                ToolTipService.BetweenShowDelay="0"
                ToolTipService.InitialShowDelay="0">
                <VectorButton:VectorFlatImageButton.ToolTip>
                    <ToolTip
                        Background="#484848"
                        Content="ESC:返回主页"
                        Foreground="White" />
                </VectorButton:VectorFlatImageButton.ToolTip>
            </VectorButton:VectorFlatImageButton>
            <VectorButton:VectorFlatImageButton
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                BorderThickness="0"
                Command="{Binding RunCommand}"
                Image="/Resource/Common/Image/IconArrowRight.png"
                ImageMargin="2"
                Style="{DynamicResource VectorFlatImageButtonStyle}"
                ToolTipService.BetweenShowDelay="0"
                ToolTipService.InitialShowDelay="0">
                <VectorButton:VectorFlatImageButton.ToolTip>
                    <ToolTip
                        Background="#484848"
                        Content="F5:运行"
                        Foreground="White" />
                </VectorButton:VectorFlatImageButton.ToolTip>
            </VectorButton:VectorFlatImageButton>
            <VectorButton:VectorFlatImageButton
                HorizontalAlignment="Left"
                Command="{Binding SaveCommand}"
                Image="/Resource/Common/Image/Save.png"
                ImageMargin="2"
                Style="{DynamicResource VectorFlatImageButtonStyle}" />
            <VectorComboBox:VectorTextComboBox
                Title="版本"
                MinWidth="100"
                HorizontalAlignment="Left"
                IsReadOnly="True"
                ItemsSource="{Binding VersionSource}"
                SelectedIndex="0"
                SelectedItem="{Binding SelectedVersion}"
                Style="{DynamicResource VectorTextComboBoxStyle}">
                <behavior:Interaction.Triggers>
                    <behavior:EventTrigger EventName="SelectionChanged">
                        <behavior:CallMethodAction MethodName="VersionBox_SelectionChanged" TargetObject="{Binding}" />
                    </behavior:EventTrigger>
                </behavior:Interaction.Triggers>
            </VectorComboBox:VectorTextComboBox>
            <VectorButton:VectorTextButton
                Padding="5"
                Background="#D0D1D4"
                Command="{Binding ImportFromClipboardCommand}"
                Foreground="Black"
                OriginBottomHeight="3"
                Style="{DynamicResource VectorTextButtonStyle}"
                Text="从剪切板导入" />
            <VectorButton:VectorTextButton
                Padding="5"
                Background="#D0D1D4"
                Command="{Binding ImportFromFileCommand}"
                Foreground="Black"
                OriginBottomHeight="3"
                Style="{DynamicResource VectorTextButtonStyle}"
                Text="从文件导入" />
            <Input:VectorTextBox
                Width="200"
                utility:TextSizeHelper.AutoFontSize="True"
                Style="{DynamicResource VectorTextBoxStyle}"
                Text="{Binding LeastPlayerUUID}"
                Visibility="{Binding LeastPlayerUUIDVisibility, Mode=OneWay}"
                WaterMarkerText="玩家低位UUID" />
            <Input:VectorTextBox
                Width="200"
                utility:TextSizeHelper.AutoFontSize="True"
                Style="{DynamicResource VectorTextBoxStyle}"
                Text="{Binding MostPlayerUUID}"
                Visibility="{Binding MostPlayerUUIDVisibility, Mode=OneWay}"
                WaterMarkerText="玩家高位UUID" />
            <Input:VectorTextBox
                Width="250"
                utility:TextSizeHelper.AutoFontSize="True"
                Style="{DynamicResource VectorTextBoxStyle}"
                Text="{Binding PlayerUUID}"
                Visibility="{Binding PlayerUUIDVisibility, Mode=OneWay}"
                WaterMarkerText="玩家UUID" />
            <VectorButton:VectorTextButton
                Command="{Binding RespawnPlayerUUIDCommand}"
                OriginBottomHeight="3"
                Style="{DynamicResource VectorTextButtonStyle}"
                Text="生成UUID"
                Visibility="{Binding IsEditGossips}" />
            <VectorButton:VectorToggleIconTextButton
                Margin="5,0,0,0"
                HorizontalAlignment="Left"
                Foreground="Black"
                IsChecked="{Binding ShowResult, Mode=OneWayToSource}"
                Style="{DynamicResource VectorToggleIconTextButtonStyle}"
                Text="显示结果" />
        </DockPanel>
        <Grid
            Grid.Row="1"
            Margin="5"
            Background="#323232">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <!--  交易项面板  -->
            <Grid
                Grid.Row="0"
                Grid.Column="0"
                Margin="10,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Height="40">
                    <TextBlock
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        FontSize="25"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="交易" />
                    <VectorButton:VectorFlatIconButton
                        Width="30"
                        Height="30"
                        Margin="0,5,0,0"
                        HorizontalAlignment="Right"
                        Command="{Binding ClearTransactionItemCommand}"
                        DockPanel.Dock="Right"
                        Icon="{StaticResource CloseMark}"
                        IconBrush="White"
                        IconHeight="10"
                        IconWidth="10"
                        Style="{DynamicResource VectorFlatIconButtonStyle}" />
                    <VectorButton:VectorFlatImageButton
                        Margin="0,5,0,0"
                        HorizontalAlignment="Right"
                        Command="{Binding AddTransactionItemCommand}"
                        DockPanel.Dock="Right"
                        Image="/Resource/Common/Image/WhiteEdit.png"
                        ImageMargin="5"
                        RenderOptions.BitmapScalingMode="NearestNeighbor"
                        RenderOptions.EdgeMode="Aliased"
                        Style="{DynamicResource VectorFlatImageButtonStyle}" />
                </DockPanel>
                <Container:VectorScrollViewer
                    Grid.Row="1"
                    Margin="0,10"
                    HorizontalScrollBarVisibility="Disabled"
                    Style="{DynamicResource VectorScrollViewerStyle}"
                    VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding TransactionItemList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel
                                        VirtualizingPanel.IsVirtualizing="True"
                                        VirtualizingPanel.ScrollUnit="Item"
                                        VirtualizingPanel.VirtualizationMode="Recycling" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <UserControlContainer:TransactionItemView />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Background="#555956" Visibility="{Binding TransactionDataGridVisibility, Mode=OneWay}">
                            <VectorButton:VectorFlatIconButton
                                Width="30"
                                Height="30"
                                Margin="10,10,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Command="{Binding CloseTransactionPanelCommand}"
                                Icon="{StaticResource CloseMark}"
                                IconBrush="White"
                                IconHeight="10"
                                IconWidth="10"
                                Style="{DynamicResource VectorFlatIconButtonStyle}" />
                            <Grid Margin="10,20,10,5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <!--#region Buy-->
                                <Input:VectorNumbericUpDown
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    Style="{DynamicResource VectorNumbericUpDownStyle}"
                                    WaterMarkerText="BuyCount"
                                    Value="{Binding BuyCount, Mode=TwoWay}" />
                                <Image
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Width="45"
                                    Height="45"
                                    HorizontalAlignment="Left"
                                    Panel.ZIndex="0"
                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                    Source="/CBHK;component/Resource/Common/Image/itemFrame.png" />
                                <Image
                                    Grid.Row="0"
                                    Width="45"
                                    Height="45"
                                    HorizontalAlignment="Left"
                                    Panel.ZIndex="1"
                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                    Source="{Binding BuyItemIcon, Mode=OneWay}"
                                    Tag="{Binding BuyItemData, Mode=OneWay}" />
                                <!--#endregion-->

                                <!--#region BuyB-->
                                <Input:VectorNumbericUpDown
                                    Grid.Row="3"
                                    HorizontalAlignment="Stretch"
                                    Style="{DynamicResource VectorNumbericUpDownStyle}"
                                    WaterMarkerText="BuyBCount"
                                    Value="{Binding BuyBCount, Mode=TwoWay}" />
                                <Image
                                    Grid.Row="2"
                                    Width="45"
                                    Height="45"
                                    HorizontalAlignment="Left"
                                    Panel.ZIndex="0"
                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                    Source="/CBHK;component/Resource/Common/Image/itemFrame.png" />
                                <Image
                                    Grid.Row="2"
                                    Width="45"
                                    Height="45"
                                    HorizontalAlignment="Left"
                                    Panel.ZIndex="1"
                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                    Source="{Binding BuyBItemIcon, Mode=OneWay}"
                                    Tag="{Binding BuyBItemData, Mode=OneWay}" />
                                <!--#endregion-->

                                <!--#region Sell-->
                                <Input:VectorNumbericUpDown
                                    Grid.Row="5"
                                    HorizontalAlignment="Stretch"
                                    Style="{DynamicResource VectorNumbericUpDownStyle}"
                                    WaterMarkerText="SellCount"
                                    Value="{Binding SellCount, Mode=TwoWay}" />
                                <Image
                                    Grid.Row="4"
                                    Width="45"
                                    Height="45"
                                    HorizontalAlignment="Left"
                                    Panel.ZIndex="0"
                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                    Source="/CBHK;component/Resource/Common/Image/itemFrame.png" />
                                <Image
                                    Grid.Row="4"
                                    Width="45"
                                    Height="45"
                                    HorizontalAlignment="Left"
                                    Panel.ZIndex="1"
                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                    Source="{Binding SellItemIcon, Mode=OneWay}"
                                    Tag="{Binding SellItemData, Mode=OneWay}" />
                                <!--#endregion-->
                            </Grid>
                            <Grid Margin="5,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <VectorButton:VectorToggleIconTextButton
                                    Grid.Row="0"
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Left"
                                    Foreground="White"
                                    IsChecked="{Binding RewardExp, Mode=TwoWay}"
                                    OriginBottomHeight="4"
                                    Style="{DynamicResource VectorToggleIconTextButtonStyle}"
                                    Text="是否奖励经验"
                                    ToolTip="1 或 0 (true/false) - true代表交易会提供经验球。Java版中所有自然生成的村民的交易都会给予经验球。" />
                                <Grid Grid.Row="1" VerticalAlignment="Top">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Input:VectorNumbericUpDown
                                        Grid.Row="0"
                                        AllowDrop="False"
                                        Background="#D0D1D4"
                                        Foreground="White"
                                        Style="{DynamicResource VectorNumbericUpDownStyle}"
                                        ToolTip="代表在交易选项失效前能进行的最大交易次数。"
                                        WaterMarkerMargin="5 0 0 0"
                                        WaterMarkerText="maxUses"
                                        Value="{Binding MaxUses, Mode=TwoWay}" />
                                    <Input:VectorNumbericUpDown
                                        Grid.Row="1"
                                        AllowDrop="False"
                                        Background="#D0D1D4"
                                        Foreground="White"
                                        Style="{DynamicResource VectorNumbericUpDownStyle}"
                                        ToolTip="已经交易的次数。"
                                        WaterMarkerMargin="5 0 0 0"
                                        WaterMarkerText="uses"
                                        Value="{Binding Uses, Mode=TwoWay}" />
                                    <Input:VectorNumbericUpDown
                                        Grid.Row="2"
                                        AllowDrop="False"
                                        Background="#D0D1D4"
                                        Foreground="White"
                                        Style="{DynamicResource VectorNumbericUpDownStyle}"
                                        ToolTip="村民从此交易选项中能获得的经验值。"
                                        WaterMarkerMargin="5 0 0 0"
                                        WaterMarkerText="xp"
                                        Value="{Binding VillagerGetXp, Mode=TwoWay}" />
                                    <Input:VectorNumbericUpDown
                                        Grid.Row="3"
                                        AllowDrop="False"
                                        Background="#D0D1D4"
                                        Foreground="White"
                                        Style="{DynamicResource VectorNumbericUpDownStyle}"
                                        ToolTip="根据需求确定的第一个收购物品的价格调节。"
                                        WaterMarkerMargin="5 0 0 0"
                                        WaterMarkerText="demand"
                                        Value="{Binding Demand, Mode=TwoWay}" />
                                    <Input:VectorNumbericUpDown
                                        Grid.Row="4"
                                        HorizontalAlignment="Stretch"
                                        AllowDrop="False"
                                        Background="#D0D1D4"
                                        Foreground="White"
                                        Style="{DynamicResource VectorNumbericUpDownStyle}"
                                        ToolTip="添加到第一个收购物品的价格调节。"
                                        WaterMarkerMargin="5 0 0 0"
                                        WaterMarkerText="specialPrice"
                                        Value="{Binding SpecialPrice, Mode=TwoWay}" />
                                    <Input:VectorNumbericUpDown
                                        Grid.Row="5"
                                        HorizontalAlignment="Stretch"
                                        AllowDrop="False"
                                        Background="#D0D1D4"
                                        Foreground="White"
                                        Style="{DynamicResource VectorNumbericUpDownStyle}"
                                        ToolTip="当前应用到此交易选项价格的乘数。"
                                        WaterMarkerMargin="5 0 0 0"
                                        WaterMarkerText="priceMultiplier"
                                        Value="{Binding PriceMultiplier, Mode=TwoWay}" />
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Container:VectorScrollViewer>
            </Grid>
            <!--  物品库、言论、记忆  -->
            <Grid Grid.Row="0" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid
                    Grid.Row="0"
                    Height="40"
                    VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <VectorComboBox:VectorTextComboBox
                        Title="种类"
                        Grid.Column="0"
                        AllowDrop="False"
                        ItemsSource="{Binding VillagerTypeSource}"
                        SelectedIndex="0"
                        SelectedItem="{Binding VillagerType, Mode=TwoWay}"
                        Style="{DynamicResource VectorTextComboBoxStyle}" />
                    <VectorComboBox:VectorTextComboBox
                        Title="职业"
                        Grid.Column="1"
                        AllowDrop="False"
                        ItemsSource="{Binding VillagerProfessionTypeSource}"
                        SelectedIndex="0"
                        SelectedItem="{Binding VillagerProfessionType, Mode=TwoWay}"
                        Style="{DynamicResource VectorTextComboBoxStyle}" />
                    <VectorComboBox:VectorTextComboBox
                        Title="交易等级"
                        Grid.Column="2"
                        AllowDrop="False"
                        ItemsSource="{Binding VillagerLevelSource}"
                        SelectedIndex="0"
                        SelectedItem="{Binding VillagerLevel, Mode=TwoWay}"
                        Style="{DynamicResource VectorTextComboBoxStyle}" />
                    <VectorButton:VectorToggleTextButton
                        Grid.Column="3"
                        Background="#D77A34"
                        Foreground="Black"
                        IsChecked="{Binding Willing, Mode=TwoWay}"
                        OriginBottomHeight="3"
                        Style="{DynamicResource VectorToggleTextButtonStyle}"
                        Text="愿意繁衍" />
                    <VectorButton:VectorToggleTextButton
                        Grid.Column="4"
                        Background="#D77A34"
                        Command="{Binding ClickGossipEditButtonCommand}"
                        Foreground="Black"
                        IsChecked="{Binding CanEditGossip, Mode=TwoWay}"
                        IsHitTestVisible="{Binding CanTouchGossip, Mode=OneWay}"
                        OriginBottomHeight="3"
                        Style="{DynamicResource VectorToggleTextButtonStyle}"
                        Text="开启言论" />
                    <VectorButton:VectorToggleTextButton
                        Grid.Column="5"
                        Background="#D77A34"
                        Command="{Binding ClickBrainEditButtonCommand}"
                        Foreground="Black"
                        IsChecked="{Binding CanEditBrain, Mode=TwoWay}"
                        IsHitTestVisible="{Binding CanTouchBrain, Mode=OneWay}"
                        OriginBottomHeight="3"
                        Style="{DynamicResource VectorToggleTextButtonStyle}"
                        Text="开启记忆" />
                </Grid>
                <Container:VectorTabControl
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectedIndex="{Binding SelectedItemListIndex}"
                    Style="{DynamicResource VectorTabControlStyle}">
                    <!--  原版背包  -->
                    <Container:VectorTextTabItem
                        Title="原版物品库"
                        Foreground="White"
                        Style="{DynamicResource VectorTextTabItemStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Input:VectorTextBox
                                Grid.Row="0"
                                HorizontalAlignment="Stretch"
                                utility:TextSizeHelper.AutoFontSize="True"
                                Style="{DynamicResource VectorTextBoxStyle}"
                                Text="{Binding SearchOriginItemText, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                                WaterMarkerMargin="5 0 0 0"
                                WaterMarkerText="搜索物品">
                                <behavior:Interaction.Triggers>
                                    <behavior:EventTrigger EventName="TextChanged">
                                        <behavior:CallMethodAction MethodName="SearchOriginItemTextBox_TextChanged" TargetObject="{Binding}" />
                                    </behavior:EventTrigger>
                                </behavior:Interaction.Triggers>
                            </Input:VectorTextBox>
                            <Container:VectorListView
                                Grid.Row="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                BorderThickness="0"
                                ItemsSource="{Binding Source={StaticResource OriginalItemView}, IsAsync=True}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                SelectedItem="{Binding SelectedItem, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                                Style="{DynamicResource VectorListViewStyle}"
                                VirtualizingPanel.IsVirtualizing="True"
                                VirtualizingPanel.ScrollUnit="Item"
                                VirtualizingPanel.VirtualizationMode="Recycling">
                                <Container:VectorListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Image
                                                Width="60"
                                                Height="60"
                                                Panel.ZIndex="0"
                                                Source="{StaticResource Slot}" />
                                            <Image
                                                x:Name="contentImage"
                                                Width="60"
                                                Height="60"
                                                Panel.ZIndex="1"
                                                RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                RenderOptions.ClearTypeHint="Enabled"
                                                SnapsToDevicePixels="True"
                                                Source="{Binding Path=ImagePath, Mode=OneWay, IsAsync=True}"
                                                ToolTip="{Binding IDAndName}"
                                                ToolTipService.BetweenShowDelay="0"
                                                ToolTipService.InitialShowDelay="0"
                                                UseLayoutRounding="False" />
                                        </Grid>
                                    </DataTemplate>
                                </Container:VectorListView.ItemTemplate>
                                <Container:VectorListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingWrapPanel:VirtualizingWrapPanel
                                            Background="Transparent"
                                            VirtualizingPanel.CacheLengthUnit="Pixel"
                                            VirtualizingPanel.IsContainerVirtualizable="True"
                                            VirtualizingPanel.IsVirtualizing="True"
                                            VirtualizingPanel.ScrollUnit="Pixel"
                                            VirtualizingPanel.VirtualizationMode="Recycling" />
                                    </ItemsPanelTemplate>
                                </Container:VectorListView.ItemsPanel>
                                <behavior:Interaction.Triggers>
                                    <behavior:EventTrigger EventName="Loaded">
                                        <behavior:CallMethodAction MethodName="OriginalItemListView_Loaded" TargetObject="{Binding}" />
                                    </behavior:EventTrigger>
                                </behavior:Interaction.Triggers>
                            </Container:VectorListView>
                        </Grid>
                    </Container:VectorTextTabItem>
                    <!--  自定义物品库  -->
                    <Container:VectorTextTabItem
                        Title="自定义物品库"
                        Foreground="White"
                        Style="{DynamicResource VectorTextTabItemStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Input:VectorTextBox
                                Grid.Row="0"
                                HorizontalAlignment="Stretch"
                                utility:TextSizeHelper.AutoFontSize="True"
                                Background="#424242"
                                BorderBrush="Black"
                                CaretBrush="White"
                                Foreground="White"
                                Style="{DynamicResource VectorTextBoxStyle}"
                                Text="{Binding SearchCustomItemText, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                                WaterMarkerMargin="5 0 0 0"
                                WaterMarkerText="搜索物品">
                                <behavior:Interaction.Triggers>
                                    <behavior:EventTrigger EventName="TextChanged">
                                        <behavior:CallMethodAction MethodName="SearchCustomItemTextBox_TextChanged" TargetObject="{Binding}" />
                                    </behavior:EventTrigger>
                                </behavior:Interaction.Triggers>
                            </Input:VectorTextBox>
                            <Container:VectorListView
                                Grid.Row="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                BorderThickness="0"
                                IsSynchronizedWithCurrentItem="True"
                                ItemsSource="{Binding Source={StaticResource CustomItemView}, IsAsync=True}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                Style="{DynamicResource VectorListViewStyle}"
                                VirtualizingPanel.IsVirtualizing="true"
                                VirtualizingPanel.ScrollUnit="Item"
                                VirtualizingPanel.VirtualizationMode="Recycling">
                                <Container:VectorListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Image
                                                Width="60"
                                                Height="60"
                                                Panel.ZIndex="0"
                                                Source="{StaticResource Slot}" />
                                            <Image
                                                x:Name="contentImage"
                                                Width="60"
                                                Height="60"
                                                Panel.ZIndex="1"
                                                RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                RenderOptions.ClearTypeHint="Enabled"
                                                SnapsToDevicePixels="True"
                                                Source="{Binding Path=ImagePath, IsAsync=True}"
                                                Tag="{Binding Path=NBT, Mode=OneWay, IsAsync=True}"
                                                ToolTip="{Binding IDAndName}"
                                                ToolTipService.BetweenShowDelay="0"
                                                ToolTipService.InitialShowDelay="0"
                                                UseLayoutRounding="False" />
                                        </Grid>
                                    </DataTemplate>
                                </Container:VectorListView.ItemTemplate>
                                <Container:VectorListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingWrapPanel:VirtualizingWrapPanel
                                            Background="#555956"
                                            VirtualizingPanel.CacheLengthUnit="Pixel"
                                            VirtualizingPanel.IsContainerVirtualizable="True"
                                            VirtualizingPanel.IsVirtualizing="True"
                                            VirtualizingPanel.ScrollUnit="Pixel"
                                            VirtualizingPanel.VirtualizationMode="Recycling" />
                                    </ItemsPanelTemplate>
                                </Container:VectorListView.ItemsPanel>
                                <behavior:Interaction.Triggers>
                                    <behavior:EventTrigger EventName="Loaded">
                                        <behavior:CallMethodAction MethodName="CustomItemListView_Loaded" TargetObject="{Binding}" />
                                    </behavior:EventTrigger>
                                </behavior:Interaction.Triggers>
                            </Container:VectorListView>
                        </Grid>
                    </Container:VectorTextTabItem>
                    <!--  杂项  -->
                    <Container:VectorTextTabItem
                        Title="杂项"
                        Foreground="White"
                        Style="{DynamicResource VectorTextTabItemStyle}">
                        <Grid VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Input:VectorNumbericUpDown
                                Grid.Row="0"
                                AllowDrop="False"
                                Background="#D0D1D4"
                                Foreground="White"
                                Style="{DynamicResource VectorNumbericUpDownStyle}"
                                ToolTip="此村民最后一次前往工作站点重新供应交易的刻。"
                                WaterMarkerMargin="5 0 0 0"
                                WaterMarkerText="LastRestock"
                                Value="{Binding LastRestock, Mode=TwoWay}" />
                            <Input:VectorNumbericUpDown
                                Grid.Row="1"
                                AllowDrop="False"
                                Background="#D0D1D4"
                                BorderThickness="0"
                                Foreground="White"
                                Style="{DynamicResource VectorNumbericUpDownStyle}"
                                ToolTip="此村民交易后获得的经验。"
                                WaterMarkerMargin="5 0 0 0"
                                WaterMarkerText="Xp"
                                Value="{Binding Xp, Mode=TwoWay}" />
                        </Grid>
                    </Container:VectorTextTabItem>
                    <!--  言论  -->
                    <Container:VectorTextTabItem
                        Title="言论"
                        Foreground="White"
                        Style="{DynamicResource VectorTextTabItemStyle}"
                        Visibility="{Binding IsEditGossips}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Input:VectorTextBox
                                    Grid.Column="0"
                                    utility:TextSizeHelper.AutoFontSize="True"
                                    Background="#313233"
                                    BorderBrush="Black"
                                    CaretBrush="White"
                                    Foreground="White"
                                    Style="{DynamicResource VectorTextBoxStyle}"
                                    Text="{Binding SearchGossipText, UpdateSourceTrigger=PropertyChanged}"
                                    WaterMarkerMargin="5 0 0 0"
                                    WaterMarkerText="搜索言论">
                                    <behavior:Interaction.Triggers>
                                        <behavior:EventTrigger EventName="TextChanged">
                                            <behavior:CallMethodAction MethodName="SearchGossipsTextChanged" TargetObject="{Binding}" />
                                        </behavior:EventTrigger>
                                    </behavior:Interaction.Triggers>
                                </Input:VectorTextBox>
                                <VectorComboBox:VectorTextComboBox
                                    Title="搜索言论类型"
                                    Grid.Column="1"
                                    Foreground="White"
                                    ItemsSource="{Binding GossipTypeList}"
                                    SelectedIndex="0"
                                    SelectedItem="{Binding SelectedSearchGossipItem}"
                                    Style="{DynamicResource VectorTextComboBoxStyle}">
                                    <behavior:Interaction.Triggers>
                                        <behavior:EventTrigger EventName="SelectionChanged">
                                            <behavior:CallMethodAction MethodName="SearchType_SelectionChanged" TargetObject="{Binding}" />
                                        </behavior:EventTrigger>
                                    </behavior:Interaction.Triggers>
                                </VectorComboBox:VectorTextComboBox>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <VectorButton:VectorTextButton
                                    Grid.Column="0"
                                    Background="#D0D1D4"
                                    Command="{Binding AddGossipItemCommand}"
                                    Foreground="Black"
                                    OriginBottomHeight="3"
                                    Style="{DynamicResource VectorTextButtonStyle}"
                                    Text="添加" />
                                <VectorButton:VectorTextButton
                                    Grid.Column="1"
                                    Background="#D0D1D4"
                                    Command="{Binding ApplyAllGossipItemCommand}"
                                    Foreground="Black"
                                    OriginBottomHeight="3"
                                    Style="{DynamicResource VectorTextButtonStyle}"
                                    Text="全部应用" />
                                <VectorButton:VectorTextButton
                                    Grid.Column="2"
                                    Background="#D0D1D4"
                                    Command="{Binding ClearGossipItemCommand}"
                                    Foreground="Black"
                                    OriginBottomHeight="3"
                                    Style="{DynamicResource VectorTextButtonStyle}"
                                    Text="清除" />
                            </Grid>
                            <Container:VectorScrollViewer
                                Grid.Row="2"
                                Margin="0,5,5,8"
                                Background="#555956"
                                HorizontalScrollBarVisibility="Disabled"
                                Style="{DynamicResource VectorScrollViewerStyle}"
                                VerticalScrollBarVisibility="Auto">
                                <behavior:Interaction.Triggers>
                                    <behavior:EventTrigger EventName="Loaded">
                                        <behavior:CallMethodAction MethodName="GossipViewerLoaded" TargetObject="{Binding}" />
                                    </behavior:EventTrigger>
                                </behavior:Interaction.Triggers>
                                <ItemsControl
                                    Grid.Row="1"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    ItemsSource="{Binding GossipItemList}"
                                    Visibility="{Binding IsEditGossips, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel
                                                VirtualizingPanel.IsVirtualizing="True"
                                                VirtualizingPanel.ScrollUnit="Item"
                                                VirtualizingPanel.VirtualizationMode="Recycling" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <UserControlContainer:GossipsItemView />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Container:VectorScrollViewer>
                        </Grid>
                    </Container:VectorTextTabItem>
                    <!--  记忆  -->
                    <Container:VectorTextTabItem
                        Title="记忆"
                        Foreground="White"
                        Style="{DynamicResource VectorTextTabItemStyle}"
                        Visibility="{Binding IsEditBrain, Mode=OneWay}">
                        <Grid Grid.Row="1" VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Input:VectorNumbericUpDown
                                Grid.Row="0"
                                Grid.Column="0"
                                utility:TextSizeHelper.AutoFontSize="True"
                                AllowDrop="False"
                                Background="Transparent"
                                BorderBrush="Black"
                                Foreground="White"
                                Style="{DynamicResource VectorNumbericUpDownStyle}"
                                WaterMarkerText="聚集点X坐标"
                                Value="{Binding MeetingPointX, Mode=TwoWay}" />
                            <Input:VectorNumbericUpDown
                                Grid.Row="0"
                                Grid.Column="1"
                                utility:TextSizeHelper.AutoFontSize="True"
                                AllowDrop="False"
                                Background="Transparent"
                                BorderBrush="Black"
                                Foreground="White"
                                Style="{DynamicResource VectorNumbericUpDownStyle}"
                                WaterMarkerText="聚集点Y坐标"
                                Value="{Binding MeetingPointY, Mode=TwoWay}" />
                            <Input:VectorNumbericUpDown
                                Grid.Row="0"
                                Grid.Column="2"
                                utility:TextSizeHelper.AutoFontSize="True"
                                AllowDrop="False"
                                Background="Transparent"
                                BorderBrush="Black"
                                Foreground="White"
                                Style="{DynamicResource VectorNumbericUpDownStyle}"
                                WaterMarkerText="聚集点Z坐标"
                                Value="{Binding MeetingPointZ, Mode=TwoWay}" />
                            <VectorComboBox:VectorTextComboBox
                                Title="聚集点维度"
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                AllowDrop="False"
                                ArrowBrush="White"
                                BorderThickness="0"
                                Foreground="White"
                                ItemsSource="{Binding DimensionTypeSource}"
                                SelectedItem="{Binding MeetingPointDimension, Mode=TwoWay}"
                                Style="{DynamicResource VectorTextComboBoxStyle}" />
                            <Input:VectorNumbericUpDown
                                Grid.Row="2"
                                Grid.Column="0"
                                utility:TextSizeHelper.AutoFontSize="True"
                                AllowDrop="False"
                                Background="Transparent"
                                BorderBrush="Black"
                                Foreground="White"
                                Style="{DynamicResource VectorNumbericUpDownStyle}"
                                WaterMarkerText="床X坐标"
                                Value="{Binding HomeX, Mode=TwoWay}" />
                            <Input:VectorNumbericUpDown
                                Grid.Row="2"
                                Grid.Column="1"
                                utility:TextSizeHelper.AutoFontSize="True"
                                AllowDrop="False"
                                Background="Transparent"
                                BorderBrush="Black"
                                Foreground="White"
                                Style="{DynamicResource VectorNumbericUpDownStyle}"
                                WaterMarkerText="床Y坐标"
                                Value="{Binding HomeY, Mode=TwoWay}" />
                            <Input:VectorNumbericUpDown
                                Grid.Row="2"
                                Grid.Column="2"
                                utility:TextSizeHelper.AutoFontSize="True"
                                AllowDrop="False"
                                Background="Transparent"
                                BorderBrush="Black"
                                Foreground="White"
                                Style="{DynamicResource VectorNumbericUpDownStyle}"
                                WaterMarkerText="床Z坐标"
                                Value="{Binding HomeZ, Mode=TwoWay}" />
                            <VectorComboBox:VectorTextComboBox
                                Title="床维度"
                                Grid.Row="3"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                AllowDrop="False"
                                ArrowBrush="White"
                                BorderThickness="0"
                                Foreground="White"
                                ItemsSource="{Binding DimensionTypeSource}"
                                SelectedItem="{Binding HomeDimension, Mode=TwoWay}"
                                Style="{DynamicResource VectorTextComboBoxStyle}" />
                            <Input:VectorNumbericUpDown
                                Grid.Row="4"
                                Grid.Column="0"
                                utility:TextSizeHelper.AutoFontSize="True"
                                AllowDrop="False"
                                Background="Transparent"
                                BorderBrush="Black"
                                Foreground="White"
                                Style="{DynamicResource VectorNumbericUpDownStyle}"
                                WaterMarkerText="工作点X坐标"
                                Value="{Binding JobSiteX, Mode=TwoWay}" />
                            <Input:VectorNumbericUpDown
                                Grid.Row="4"
                                Grid.Column="1"
                                Margin="0,0,5,0"
                                utility:TextSizeHelper.AutoFontSize="True"
                                AllowDrop="False"
                                Background="Transparent"
                                BorderBrush="Black"
                                Foreground="White"
                                Style="{DynamicResource VectorNumbericUpDownStyle}"
                                WaterMarkerText="工作点Y坐标"
                                Value="{Binding JobSiteY, Mode=TwoWay}" />
                            <Input:VectorNumbericUpDown
                                Grid.Row="4"
                                Grid.Column="2"
                                utility:TextSizeHelper.AutoFontSize="True"
                                AllowDrop="False"
                                Background="Transparent"
                                BorderBrush="Black"
                                Foreground="White"
                                Style="{DynamicResource VectorNumbericUpDownStyle}"
                                WaterMarkerText="工作点Z坐标"
                                Value="{Binding JobSiteZ, Mode=TwoWay}" />
                            <VectorComboBox:VectorTextComboBox
                                Title="工作点维度"
                                Grid.Row="5"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                AllowDrop="False"
                                ArrowBrush="White"
                                BorderThickness="0"
                                Foreground="White"
                                ItemsSource="{Binding DimensionTypeSource}"
                                SelectedItem="{Binding JobSiteDimension, Mode=TwoWay}"
                                Style="{DynamicResource VectorTextComboBoxStyle}" />
                        </Grid>
                    </Container:VectorTextTabItem>
                </Container:VectorTabControl>
            </Grid>
        </Grid>
    </Grid>
</Container:VectorWindow>
