<Container:VectorWindow
    x:Class="CBHK.View.Generator.ChatTypeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Container="clr-namespace:CBHK.CustomControl.Container"
    xmlns:VectorComboBo="clr-namespace:CBHK.CustomControl.VectorComboBox"
    xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CBHK.View.Generator"
    xmlns:json="clr-namespace:CBHK.Utility.Data.JsonText"
    xmlns:mcdoc="clr-namespace:CBHK.Utility.Data.Mcdoc"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Title="聊天类型编辑器"
    Width="1080"
    Height="700"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="#1B1B1B"
    IconMargin="5"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <VectorComboBo:VectorTextComboBox
            Title="版本"
            Grid.Row="0"
            Height="30"
            ItemsSource="{Binding VersionList}"
            SelectedIndex="0"
            SelectedItem="{Binding CurrentVersion}"
            Style="{StaticResource VectorTextComboBoxStyle}" />
        <DockPanel Grid.Row="1" Grid.Column="0">
            <ContentControl
                DockPanel.Dock="Top"
                Content="{Binding}"
                ContentTemplate="{StaticResource McdocGeneratorChrome}" />
            <TextBlock
                DockPanel.Dock="Bottom"
                Margin="6,2"
                FontSize="12"
                Foreground="{DynamicResource CommonForeground}"
                Text="{Binding MdocStatus}"
                TextTrimming="CharacterEllipsis" />
            <mcdoc:McdocTreeRowView
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Transparent"
            ItemContainerStyle="{StaticResource McdocRowItemContainerStyle}"
            ItemTemplateSelector="{StaticResource McdocRowTemplateSelector}"
            ItemsSource="{Binding Rows}"  />
        </DockPanel>
        <GridSplitter
            Grid.Row="1"
            Grid.Column="1"
            VerticalAlignment="Stretch"
            Background="Transparent"
            BorderBrush="{DynamicResource CommonForeground}"
            BorderThickness="1,0,1,0"
            ResizeBehavior="PreviousAndNext" />
        <json:JsonTextEditor mcdoc:McdocJsonEditorHost.IsEnabled="True"
            Grid.Row="1"
            Grid.Column="2"
            Margin="5"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Transparent"
            FontFamily="JetBrains Mono"
            Foreground="{DynamicResource CommonForeground}"
            HorizontalScrollBarVisibility="Auto"
            IsReadOnly="False"
            LineNumbersForeground="{DynamicResource CommonForeground}"
            ShowLineNumbers="True"
            VerticalScrollBarVisibility="Auto"
            WordWrap="True">
        </json:JsonTextEditor>
    </Grid>

</Container:VectorWindow>
