<Container:VectorWindow
    x:Class="CBHK.View.Generator.AdvancementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Container="clr-namespace:CBHK.CustomControl.Container"
    xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jsonText="clr-namespace:CBHK.Utility.Data.JsonText"
    xmlns:local="clr-namespace:CBHK.View.Generator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mcdoc="clr-namespace:CBHK.Utility.Data.Mcdoc"
    xmlns:prism="http://prismlibrary.com/"
    Title="{Binding ViewName}"
    Width="1080"
    Height="700"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="Transparent"
    IconMargin="5"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ContentControl
            Grid.Row="0"
            Grid.Column="0"
            Content="{Binding}"
            ContentTemplate="{StaticResource McdocGeneratorChrome}" />
        <TextBlock
            Grid.Row="0"
            Grid.Column="2"
            Margin="5,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            FontSize="13"
            Foreground="{DynamicResource CommonForeground}"
            Opacity="0.6"
            Text="{Binding MdocStatus}"
            TextTrimming="CharacterEllipsis"
            ToolTip="{Binding MdocStatus}" />
        <mcdoc:McdocTreeRowView
            Grid.Row="1"
            Grid.Column="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Transparent"
            ItemContainerStyle="{StaticResource McdocRowItemContainerStyle}"
            ItemTemplateSelector="{StaticResource McdocRowTemplateSelector}"
            ItemsSource="{Binding Rows}" />
        <GridSplitter
            Grid.Row="1"
            Grid.Column="1"
            VerticalAlignment="Stretch"
            Background="Transparent"
            BorderBrush="{DynamicResource CommonForeground}"
            BorderThickness="1,0,1,0"
            ResizeBehavior="PreviousAndNext" />
        <!--
            右侧 JSON 编辑器：JsonTextEditor 派生自 AvalonEdit 的 TextEditor，
            自带 JSON 解析 + 锚点表，树上的编辑会手术式回写到这里（只改那一段）。
        -->
        <jsonText:JsonTextEditor
            Grid.Row="1"
            Grid.Column="2"
            Margin="5"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            mcdoc:McdocJsonEditorHost.IsEnabled="True"
            Background="Transparent"
            FontFamily="JetBrains Mono"
            Foreground="{DynamicResource CommonForeground}"
            HorizontalScrollBarVisibility="Auto"
            IsReadOnly="False"
            LineNumbersForeground="{DynamicResource CommonForeground}"
            ShowLineNumbers="True"
            VerticalScrollBarVisibility="Auto"
            WordWrap="True" />
    </Grid>
</Container:VectorWindow>
