<Container:VectorWindow
    x:Class="CBHK.View.Generator.DimensionTypeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Container="clr-namespace:CBHK.CustomControl.Container"
    xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CBHK.View.Generator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Title="维度类型"
    Width="1080"
    Height="700"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="#1B1B1B"
    IconMargin="5"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Container:VectorTreeView
            Grid.Row="1"
            Grid.Column="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Transparent"
            BorderThickness="0"
            ItemTemplateSelector="{StaticResource MCDocumentTreeViewTemplateSelector}"
            ItemsSource="{Binding TreeViewItemList}"
            Style="{DynamicResource VectorTreeViewStyle}" />
        <GridSplitter
            Grid.Column="1"
            VerticalAlignment="Stretch"
            Background="Transparent"
            BorderBrush="Gray"
            BorderThickness="1,0,1,0"
            ResizeBehavior="PreviousAndNext" />
        <avalonedit:TextEditor
            Grid.Column="2"
            MinWidth="200"
            Margin="5"
            Background="Transparent"
            FontFamily="JetBrains Mono"
            Foreground="White"
            HorizontalScrollBarVisibility="Auto"
            LineNumbersForeground="White"
            ShowLineNumbers="True"
            VerticalScrollBarVisibility="Auto"
            WordWrap="True">
            <behaviors:Interaction.Triggers>
                <behaviors:EventTrigger EventName="Loaded">
                    <behaviors:CallMethodAction MethodName="TextEditor_Loaded" TargetObject="{Binding}" />
                </behaviors:EventTrigger>
                <behaviors:EventTrigger EventName="LostFocus">
                    <behaviors:CallMethodAction MethodName="TextEditor_LostFocus" TargetObject="{Binding}" />
                </behaviors:EventTrigger>
            </behaviors:Interaction.Triggers>
        </avalonedit:TextEditor>
    </Grid>
</Container:VectorWindow>
