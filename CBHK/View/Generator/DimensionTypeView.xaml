<Container:VectorWindow
    x:Class="CBHK.View.Generator.DimensionTypeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Container="clr-namespace:CBHK.CustomControl.Container"
    xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:json="clr-namespace:CBHK.Utility.Data.JsonText"
    xmlns:local="clr-namespace:CBHK.View.Generator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mcdoc="clr-namespace:CBHK.Utility.Data.Mcdoc"
    xmlns:prism="http://prismlibrary.com/"
    Title="维度类型"
    Width="1080"
    Height="700"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="#1B1B1B"
    IconMargin="5"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Row="1" Grid.Column="0">
            <ContentControl
                Content="{Binding}"
                ContentTemplate="{StaticResource McdocGeneratorChrome}"
                DockPanel.Dock="Top" />
            <TextBlock
                Margin="6,2"
                DockPanel.Dock="Bottom"
                FontSize="12"
                Foreground="{DynamicResource CommonForeground}"
                Text="{Binding MdocStatus}"
                TextTrimming="CharacterEllipsis" />
            <mcdoc:McdocTreeRowView
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent"
                ItemContainerStyle="{StaticResource McdocRowItemContainerStyle}"
                ItemTemplateSelector="{StaticResource McdocRowTemplateSelector}"
                ItemsSource="{Binding Rows}" />
        </DockPanel>
        <GridSplitter
            Grid.Column="1"
            VerticalAlignment="Stretch"
            Background="Transparent"
            BorderBrush="{DynamicResource CommonForeground}"
            BorderThickness="1,0,1,0"
            ResizeBehavior="PreviousAndNext" />
        <json:JsonTextEditor
            Grid.Column="2"
            MinWidth="200"
            Margin="5"
            mcdoc:McdocJsonEditorHost.IsEnabled="True"
            Background="Transparent"
            FontFamily="JetBrains Mono"
            Foreground="{DynamicResource CommonForeground}"
            HorizontalScrollBarVisibility="Auto"
            LineNumbersForeground="{DynamicResource CommonForeground}"
            ShowLineNumbers="True"
            VerticalScrollBarVisibility="Auto"
            WordWrap="True" />
    </Grid>
</Container:VectorWindow>
