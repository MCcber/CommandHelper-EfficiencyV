<Container:VectorWindow
    x:Class="CBHK.View.Generator.TagView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Container="clr-namespace:CBHK.CustomControl.Container"
    xmlns:Input="clr-namespace:CBHK.CustomControl.Input"
    xmlns:VectorButton="clr-namespace:CBHK.CustomControl.VectorButton"
    xmlns:VectorCheckBox="clr-namespace:CBHK.CustomControl.VectorCheckBox"
    xmlns:VectorComboBox="clr-namespace:CBHK.CustomControl.VectorComboBox"
    xmlns:behavior="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:utility="clr-namespace:CBHK.Utility.Visual"
    Title="标签生成器"
    Width="835"
    Height="530"
    MinWidth="835"
    MinHeight="530"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Icon="/CBHK;component/Resource/Common/Image/SpawnerIcon/IconTag.png"
    IconMargin="5"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <CollectionViewSource x:Key="TagItemSource" Source="{Binding TagItemList, IsAsync=True}" />
        <ImageBrush x:Key="ButtonNormal" ImageSource="/CBHK;component/Resource/Common/Image/ButtonNormal.png" />
        <ImageBrush x:Key="ButtonPressed" ImageSource="/CBHK;component/Resource/Common/Image/ButtonPressed.png" />
        <ImageBrush x:Key="EditBox" ImageSource="/CBHK;component/Resource/Common/Image/TextEditBox.png" />
        <ImageBrush x:Key="Issue" ImageSource="/CBHK;component/Resource/Common/Image/Issue.png" />
        <ImageBrush x:Key="LeftArrow" ImageSource="/CBHK;component/Resource/Common/Image/IconArrowLeft.png" />
        <ImageBrush x:Key="RightArrow" ImageSource="/CBHK;component/Resource/Common/Image/IconArrowRight.png" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RunCommand}" />
        <KeyBinding
            Key="Esc"
            Command="{Binding ReturnCommand}"
            CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Container:VectorWindow}}" />
    </Window.InputBindings>

    <behavior:Interaction.Triggers>
        <behavior:EventTrigger EventName="Loaded">
            <behavior:CallMethodAction MethodName="TagView_Loaded" TargetObject="{Binding}" />
        </behavior:EventTrigger>
    </behavior:Interaction.Triggers>

    <Grid VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Height="40">
            <VectorButton:VectorFlatImageButton
                Command="{Binding ReturnCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Container:VectorWindow}}"
                Image="/Resource/Common/Image/IconArrowLeft.png"
                ImageMargin="5"
                Style="{DynamicResource VectorFlatImageButtonStyle}"
                ToolTipService.BetweenShowDelay="0"
                ToolTipService.InitialShowDelay="0">
                <VectorButton:VectorFlatImageButton.ToolTip>
                    <ToolTip
                        Background="#484848"
                        Content="ESC:返回主页"
                        Foreground="White" />
                </VectorButton:VectorFlatImageButton.ToolTip>
            </VectorButton:VectorFlatImageButton>
            <VectorButton:VectorFlatImageButton
                Command="{Binding RunCommand}"
                Image="/Resource/Common/Image/IconArrowRight.png"
                ImageMargin="5"
                Style="{DynamicResource VectorFlatImageButtonStyle}"
                ToolTipService.BetweenShowDelay="0"
                ToolTipService.InitialShowDelay="0">
                <VectorButton:VectorFlatImageButton.ToolTip>
                    <ToolTip
                        Background="#484848"
                        Content="F5:运行"
                        Foreground="White" />
                </VectorButton:VectorFlatImageButton.ToolTip>
            </VectorButton:VectorFlatImageButton>
            <VectorCheckBox:VectorTextCheckBox
                Margin="5,0,0,0"
                Foreground="{StaticResource CommonForeground}"
                IsChecked="{Binding Replace, Mode=TwoWay}"
                Style="{DynamicResource VectorTextCheckBoxStyle}"
                Text="替换"
                ToolTip="Replace"
                ToolTipService.InitialShowDelay="0"
                ToolTipService.ShowDuration="3000" />
            <VectorCheckBox:VectorTextCheckBox
                Margin="5,0,0,0"
                Foreground="{StaticResource CommonForeground}"
                IsChecked="{Binding SelectedAll, Mode=OneWayToSource}"
                Style="{DynamicResource VectorTextCheckBoxStyle}"
                Text="全选">
                <behavior:Interaction.Triggers>
                    <behavior:EventTrigger EventName="Click">
                        <behavior:CallMethodAction MethodName="SelectAll_Click" TargetObject="{Binding}" />
                    </behavior:EventTrigger>
                </behavior:Interaction.Triggers>
            </VectorCheckBox:VectorTextCheckBox>
            <VectorCheckBox:VectorTextCheckBox
                Margin="5,0,0,0"
                Foreground="{StaticResource CommonForeground}"
                IsChecked="{Binding ReverseAll, Mode=OneWayToSource}"
                Style="{DynamicResource VectorTextCheckBoxStyle}"
                Text="反选">
                <behavior:Interaction.Triggers>
                    <behavior:EventTrigger EventName="Click">
                        <behavior:CallMethodAction MethodName="ReverseAll_Click" TargetObject="{Binding}" />
                    </behavior:EventTrigger>
                </behavior:Interaction.Triggers>
            </VectorCheckBox:VectorTextCheckBox>
            <VectorComboBox:VectorTextComboBox
                Title="标签目录"
                MinWidth="200"
                Margin="5,0,0,0"
                ArrowMargin="2"
                BorderBrush="Black"
                IsReadOnly="True"
                ItemsSource="{Binding TagRegistryList}"
                SelectedItem="{Binding SelectedTagRegistry, Mode=TwoWay}"
                Style="{DynamicResource VectorTextComboBoxStyle}"
                ToolTip="data/&lt;命名空间&gt;/tags/&lt;标签目录&gt;/&lt;标签名&gt;.json" />
            <VectorComboBox:VectorTextComboBox
                Title="版本"
                MinWidth="100"
                ArrowMargin="2"
                IsReadOnly="True"
                ItemsSource="{Binding VersionList}"
                SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                Style="{DynamicResource VectorTextComboBoxStyle}" />
            <VectorButton:VectorTextButton
                Command="{Binding ImportFromClipboardCommand}"
                OriginBottomHeight="3"
                Style="{DynamicResource VectorTextButtonStyle}"
                Text="从剪切板导入" />
            <VectorButton:VectorTextButton
                Command="{Binding ImportFromFileCommand}"
                OriginBottomHeight="3"
                Style="{DynamicResource VectorTextButtonStyle}"
                Text="从文件导入" />
            <Input:VectorTextBox
                HorizontalAlignment="Stretch"
                VerticalContentAlignment="Center"
                utility:TextSizeHelper.AutoFontSize="True"
                Background="#313233"
                BorderBrush="Black"
                CaretBrush="White"
                Foreground="White"
                Style="{DynamicResource VectorTextBoxStyle}"
                Text="{Binding SearchText, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                TextAlignment="Left"
                WaterMarkerBrush="Gray"
                WaterMarkerMargin="5 0 0 0"
                WaterMarkerText="搜索成员">
                <behavior:Interaction.Triggers>
                    <behavior:EventTrigger EventName="TextChanged">
                        <behavior:CallMethodAction MethodName="SearchTextBox_TextChanged" TargetObject="{Binding}" />
                    </behavior:EventTrigger>
                </behavior:Interaction.Triggers>
            </Input:VectorTextBox>
        </DockPanel>

        <!--  tag 元信息：命名空间 / 标签名 / 输出形态 / 目标路径提示  -->
        <DockPanel Grid.Row="1" Height="34">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{StaticResource CommonForeground}"
                Text="命名空间" />
            <Input:VectorTextBox
                Width="110"
                Height="30"
                Margin="5,0,0,0"
                VerticalContentAlignment="Center"
                Background="#313233"
                BorderBrush="Black"
                CaretBrush="White"
                Foreground="White"
                Style="{DynamicResource VectorTextBoxStyle}"
                Text="{Binding NamespaceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextAlignment="Left"
                WaterMarkerBrush="Gray"
                WaterMarkerMargin="5 0 0 0"
                WaterMarkerText="minecraft" />
            <TextBlock
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Foreground="{StaticResource CommonForeground}"
                Text="标签名" />
            <Input:VectorTextBox
                Width="130"
                Height="30"
                Margin="5,0,0,0"
                VerticalContentAlignment="Center"
                Background="#313233"
                BorderBrush="Black"
                CaretBrush="White"
                Foreground="White"
                Style="{DynamicResource VectorTextBoxStyle}"
                Text="{Binding TagName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextAlignment="Left"
                WaterMarkerBrush="Gray"
                WaterMarkerMargin="5 0 0 0"
                WaterMarkerText="planks" />
            <VectorCheckBox:VectorTextCheckBox
                Margin="10,0,0,0"
                Foreground="{StaticResource CommonForeground}"
                IsChecked="{Binding UseObjectForm, Mode=TwoWay}"
                Style="{DynamicResource VectorTextCheckBoxStyle}"
                Text="对象形式"
                ToolTip="勾选项输出为对象形态（带 id 键），而不是裸字符串"
                ToolTipService.InitialShowDelay="0" />
            <TextBlock
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Foreground="Gray"
                Text="{Binding TargetPath}"
                ToolTip="导出时应放到这个路径下" />
        </DockPanel>

        <!--  附加条目：裸 id / #tag 引用 / 对象 JSON，每行一条  -->
        <DockPanel Grid.Row="2" Height="34">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{StaticResource CommonForeground}"
                Text="附加条目" />
            <Input:VectorTextBox
                Height="30"
                Margin="5,0,0,0"
                VerticalContentAlignment="Center"
                Background="#313233"
                BorderBrush="Black"
                CaretBrush="White"
                Foreground="White"
                Style="{DynamicResource VectorTextBoxStyle}"
                Text="{Binding ExtraValuesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextAlignment="Left"
                WaterMarkerBrush="Gray"
                WaterMarkerMargin="5 0 0 0"
                WaterMarkerText="每行一条：裸 id 或 #标签引用 或 对象 JSON（重复项会自动去重）" />
        </DockPanel>

        <Container:VectorListView
            Grid.Row="3"
            ItemsSource="{Binding Source={StaticResource TagItemSource}, IsAsync=True}"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
            Style="{DynamicResource VectorListViewStyle}"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingPanel.VirtualizationMode="Recycling">
            <Container:VectorListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ToggleButton
                                x:Name="checkButton"
                                IsChecked="{Binding BeChecked, Mode=TwoWay}"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                            <!--
                                选中标记：与下拉框里的选中勾同一个画法（VectorComboBoxItemContainer.xaml 的 8 个 Rectangle 斜勾），
                                Viewbox 统一缩到 16×16。用 Hidden 而不是 Collapsed —— 列宽保持不变，勾来勾去名字不会左右跳。
                            -->
                            <Viewbox
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="0"
                                Width="16"
                                Height="16"
                                Margin="10,0,6,0"
                                VerticalAlignment="Center">
                                <Viewbox.Style>
                                    <Style TargetType="Viewbox">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BeChecked}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Viewbox.Style>
                                <Grid UseLayoutRounding="False">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1" />
                                        <RowDefinition Height="1" />
                                        <RowDefinition Height="1" />
                                        <RowDefinition Height="1" />
                                        <RowDefinition Height="1" />
                                        <RowDefinition Height="1" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="1" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Width="2"
                                        Height="2"
                                        Fill="{DynamicResource CommonForeground}" />
                                    <Rectangle
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Width="2"
                                        Height="2"
                                        Fill="{DynamicResource CommonForeground}" />
                                    <Rectangle
                                        Grid.Row="5"
                                        Grid.Column="2"
                                        Width="2"
                                        Height="2"
                                        Fill="{DynamicResource CommonForeground}" />
                                    <Rectangle
                                        Grid.Row="4"
                                        Grid.Column="3"
                                        Width="2"
                                        Height="2"
                                        Fill="{DynamicResource CommonForeground}" />
                                    <Rectangle
                                        Grid.Row="3"
                                        Grid.Column="4"
                                        Width="2"
                                        Height="2"
                                        Fill="{DynamicResource CommonForeground}" />
                                    <Rectangle
                                        Grid.Row="2"
                                        Grid.Column="5"
                                        Width="2"
                                        Height="2"
                                        Fill="{DynamicResource CommonForeground}" />
                                    <Rectangle
                                        Grid.Row="1"
                                        Grid.Column="6"
                                        Width="2"
                                        Height="2"
                                        Fill="{DynamicResource CommonForeground}" />
                                    <Rectangle
                                        Grid.Row="0"
                                        Grid.Column="7"
                                        Width="2"
                                        Height="2"
                                        Fill="{DynamicResource CommonForeground}" />
                                </Grid>
                            </Viewbox>
                            <Image
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="1"
                                Width="65"
                                Height="65"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                RenderOptions.BitmapScalingMode="NearestNeighbor"
                                Source="{Binding Icon, IsAsync=True}" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="25"
                                IsHitTestVisible="False"
                                Text="{Binding DisplayId, IsAsync=True}"
                                TextAlignment="Left" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="25"
                                IsHitTestVisible="False"
                                Text="{Binding DisplayName, IsAsync=True}"
                                TextAlignment="Left" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </Container:VectorListView.ItemTemplate>
            <Container:VectorListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel
                        VirtualizingPanel.CacheLengthUnit="Pixel"
                        VirtualizingPanel.IsContainerVirtualizable="True"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        VirtualizingPanel.VirtualizationMode="Recycling" />
                </ItemsPanelTemplate>
            </Container:VectorListView.ItemsPanel>
            <behavior:Interaction.Triggers>
                <behavior:EventTrigger EventName="Loaded">
                    <behavior:CallMethodAction MethodName="ListViewLoaded" TargetObject="{Binding}" />
                </behavior:EventTrigger>
                <behavior:EventTrigger EventName="PreviewMouseLeftButtonUp">
                    <behavior:CallMethodAction MethodName="ListBoxClick" TargetObject="{Binding}" />
                </behavior:EventTrigger>
            </behavior:Interaction.Triggers>
        </Container:VectorListView>
    </Grid>
</Container:VectorWindow>
